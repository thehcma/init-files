      { "hooks": [{ "type": "command", "command": "[ \"$(uname -s)\" = Darwin ] && exec \"$HOME/.config/iterm2/cc-status\"; true" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "[ \"$(uname -s)\" = Darwin ] && exec \"$HOME/.config/iterm2/cc-status\"; true" }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "[ \"$(uname -s)\" = Darwin ] && exec \"$HOME/.config/iterm2/cc-status\"; true" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "[ \"$(uname -s)\" = Darwin ] && exec \"$HOME/.config/iterm2/cc-status\"; true" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "[ \"$(uname -s)\" = Darwin ] && exec \"$HOME/.config/iterm2/cc-status\"; true" }] }
