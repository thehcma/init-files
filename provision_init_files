# Required bash-completion@2 on modern macOS (readable script, not an executable).
# Older macOS / Linux: optional presence only (no brew on older macOS).
record_bash_completion()
{
    local name="bash-completion"
    local hint candidate path=""

    if is_modern_macos; then
        hint="brew install bash-completion@2"
        for candidate in \
            ${brew_prefix:+"$brew_prefix/etc/profile.d/bash_completion.sh"} \
            ${brew_prefix:+"$brew_prefix/share/bash-completion/bash_completion"}
        do
            if [[ -n "$candidate" && -r "$candidate" ]]; then
                path="$candidate"
                break
            fi
        done
        if [[ -n "$path" ]]; then
            # Record path for bashrc; skipped by init_files_verify_tool_path (-x) so we do
            # not put it in TOOL_EXPORTS — only REQUIRED_MISSING when absent.
            log "  OK       ${name} -> ${path}"
            return 0
        fi
        REQUIRED_MISSING+=("${name}|${hint}")
        log "  MISSING  ${name} (required) — ${hint}"
        return 0
    fi

    if is_darwin; then
        hint="install bash-completion without Homebrew (brew not recommended on this macOS)"
    elif command -v apt-get >/dev/null 2>&1 || command -v apt >/dev/null 2>&1; then
        hint="sudo apt install bash-completion"
    elif command -v dnf >/dev/null 2>&1; then
        hint="sudo dnf install bash-completion"
    else
        hint="install bash-completion via your OS package manager"
    fi

    for candidate in \
        ${brew_prefix:+"$brew_prefix/etc/profile.d/bash_completion.sh"} \
        /usr/share/bash-completion/bash_completion \
        /etc/bash_completion \
        /usr/local/etc/profile.d/bash_completion.sh \
        /usr/local/etc/bash_completion
    do
        if [[ -n "$candidate" && -r "$candidate" ]]; then
            log "  OK       ${name} -> ${candidate}"
            return 0
        fi
    done
    OPTIONAL_MISSING+=("${name}|${hint}")
    log "  missing  ${name} (optional) — ${hint}"
}

