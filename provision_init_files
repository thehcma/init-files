_init_files_vim_font_hint()
{
    local helper="${repo_dir}/iterm2/install_meslo_nerd_font"
    if [[ "${OSTYPE:-}" == darwin* ]]; then
        log "Note: Nerd Font for Vim glyphs: ${helper}   # Meslo.zip → ~/Library/Fonts (no sudo)"
    else
        log "Note: Nerd Font for Vim glyphs: ${helper}   # or Meslo.zip → ~/.local/share/fonts && fc-cache -f"
    fi
}

backup_existing_vimrc()
{
    local backup stamp state_copy current

    [[ -e "$vimrc_dest" || -L "$vimrc_dest" ]] || return 0

    # Already our symlink — nothing to save.
    if [[ -L "$vimrc_dest" ]]; then
        current=$(readlink "$vimrc_dest" 2>/dev/null || true)
        if [[ "$current" == "$vimrc_src" ]]; then
            return 0
        fi
    fi

    stamp="$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$vim_backup_dir" 2>/dev/null || true

    if [[ -L "$vimrc_dest" ]]; then
        backup="${vimrc_dest}.bak.${stamp}"
        # Preserve the old symlink target path in a small sidecar text file.
        printf '%s\n' "$(readlink "$vimrc_dest" 2>/dev/null || true)" > "${backup}.linktarget"
        rm -f "$vimrc_dest" || return 1
        log "Removed previous ~/.vimrc symlink (target saved in ${backup}.linktarget)"
        return 0
    fi

    if [[ ! -f "$vimrc_dest" ]]; then
        init_files_warn "$vimrc_dest exists and is not a regular file or symlink"
        return 1
    fi

    backup="${vimrc_dest}.bak.${stamp}"
    cp -p "$vimrc_dest" "$backup" || return 1
    state_copy="${vim_backup_dir}/vimrc.${stamp}"
    cp -p "$vimrc_dest" "$state_copy" 2>/dev/null || true
    log "Backed up existing ~/.vimrc -> $backup"
    [[ -f "$state_copy" ]] && log "         (also $state_copy)"
    rm -f "$vimrc_dest" || return 1
}

# One-file model: GUI settings live in vim/vimrc. A host ~/.gvimrc loads after
# vimrc and would override guifont etc. — back it up and remove it.
retire_host_gvimrc()
{
    local backup stamp state_copy current

    [[ -e "$gvimrc_dest" || -L "$gvimrc_dest" ]] || {
        log "OK       no ~/.gvimrc (single vimrc model)"
        return 0
    }

    stamp="$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$vim_backup_dir" 2>/dev/null || true

    if [[ -L "$gvimrc_dest" ]]; then
        current=$(readlink "$gvimrc_dest" 2>/dev/null || true)
        printf '%s\n' "$current" > "${gvimrc_dest}.bak.${stamp}.linktarget"
        printf '%s\n' "$current" > "${vim_backup_dir}/gvimrc.${stamp}.linktarget" 2>/dev/null || true
        rm -f "$gvimrc_dest" || return 1
        log "Retired  ~/.gvimrc symlink (target saved in ${gvimrc_dest}.bak.${stamp}.linktarget)"
        return 0
    fi

    if [[ ! -f "$gvimrc_dest" ]]; then
        init_files_warn "$gvimrc_dest exists and is not a regular file or symlink"
        return 1
    fi

    backup="${gvimrc_dest}.bak.${stamp}"
    cp -p "$gvimrc_dest" "$backup" || return 1
    state_copy="${vim_backup_dir}/gvimrc.${stamp}"
    cp -p "$gvimrc_dest" "$state_copy" 2>/dev/null || true
    rm -f "$gvimrc_dest" || return 1
    log "Retired  ~/.gvimrc -> $backup (GUI settings are in vim/vimrc)"
    [[ -f "$state_copy" ]] && log "         (also $state_copy)"
}

link_vimrc_to_repo()
{
    local current

    if [[ ! -f "$vimrc_src" ]]; then
        log "Skip vimrc: missing $vimrc_src"
        return 0
    fi

    if [[ -L "$vimrc_dest" ]]; then
        current=$(readlink "$vimrc_dest" 2>/dev/null || true)
        if [[ "$current" == "$vimrc_src" ]]; then
            log "OK       ~/.vimrc -> $vimrc_src"
            return 0
        fi
    fi

    backup_existing_vimrc || return 1
    ln -s "$vimrc_src" "$vimrc_dest" || return 1
    log "Linked   ~/.vimrc -> $vimrc_src"
}

bootstrap_vim_plug()
{
    local curl_bin
    if [[ -f "$vim_plug_path" ]]; then
        log "OK       vim-plug ($vim_plug_path)"
        return 0
    fi
    curl_bin="$(command -v curl 2>/dev/null || true)"
    if [[ -z "$curl_bin" ]]; then
        log "WARN     curl missing; cannot bootstrap vim-plug"
        return 1
    fi
    mkdir -p "$(dirname "$vim_plug_path")" || return 1
    if ! "$curl_bin" -fsSL --connect-timeout 10 --max-time 60 \
        -o "$vim_plug_path" "$vim_plug_url"; then
        log "WARN     failed to download vim-plug"
        rm -f "$vim_plug_path"
        return 1
    fi
    log "Installed vim-plug -> $vim_plug_path"
}

run_vim_plug_install()
{
    local vim_bin
    vim_bin="$(_init_files_vim_bin)" || {
        log "WARN     vim not found; skip PlugInstall"
        return 1
    }
    mkdir -p "${HOME}/.vim/plugged" "${HOME}/.vim/undo" 2>/dev/null || true
    # Headless PlugInstall; warn-only for provision_init_files.
    if ! "$vim_bin" -n -u "$vimrc_dest" +PlugInstall +qall \
        --not-a-term </dev/null >/dev/null 2>&1 \
        && ! "$vim_bin" -n -u "$vimrc_dest" +PlugInstall +qall \
        </dev/null >/dev/null 2>&1; then
        log "WARN     vim PlugInstall failed (network?). Retry: refresh_vimrc"
        return 1
    fi
    log "OK       vim plugins (PlugInstall)"
}

link_vimrc_to_repo
retire_host_gvimrc || true
