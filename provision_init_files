# Login shells (Debian/Ubuntu SSH, macOS Terminal) read ~/.profile or
# ~/.bash_profile — not ~/.bashrc — unless those files source it.
# Always install our marker when missing. bashrc is idempotent
# (INIT_FILES_BASHRC_LOADED), so a second source from Debian's default
# .profile block is harmless.
ensure_login_shell_sources_bashrc()
{
    local marker_begin='# >>> init-files >>>'
    local marker_end='# <<< init-files <<<'
    local block target target_real bashrc_real

    # bash(1): .bash_profile / .bash_login suppress .profile
    if [[ -e "${HOME}/.bash_profile" ]]; then
        target="${HOME}/.bash_profile"
    elif [[ -e "${HOME}/.bash_login" ]]; then
        target="${HOME}/.bash_login"
    else
        target="${HOME}/.profile"
    fi

    if [[ "$(basename "$target")" == ".bash_profile" || "$(basename "$target")" == ".bash_login" ]]; then
        # .bash_profile shadows .profile — pull .profile in first (PATH, cargo,
        # etc.), then ensure bashrc. bashrc ignores a duplicate source.
        block=$(cat <<EOF
${marker_begin}
# bash login shells read this file instead of ~/.profile.
if [ -f "\$HOME/.profile" ]; then
    . "\$HOME/.profile"
fi
if [ -n "\${BASH_VERSION:-}" ] && [ -f "\$HOME/.bashrc" ]; then
    . "\$HOME/.bashrc"
fi
${marker_end}
EOF
)
    else
        block=$(cat <<EOF
${marker_begin}
# Ensure bash login shells load ~/.bashrc (init-files symlink).
if [ -n "\${BASH_VERSION:-}" ]; then
    if [ -f "\$HOME/.bashrc" ]; then
        . "\$HOME/.bashrc"
    fi
fi
${marker_end}
EOF
)
    fi

    # If .bash_profile is a symlink to .bashrc (some macOS setups), login
    # shells already load init-files — do not append into bashrc itself.
    bashrc_real=$(cd "$(dirname "${HOME}/.bashrc")" && pwd)/$(basename "${HOME}/.bashrc")
    if [[ -L "${HOME}/.bashrc" ]]; then
        bashrc_real=$(readlink "${HOME}/.bashrc" 2>/dev/null || true)
        [[ "$bashrc_real" == /* ]] || bashrc_real="${HOME}/.local/share/init-files/bashrc"
    fi
    if [[ -L "$target" || -f "$target" ]]; then
        target_real=$(readlink "$target" 2>/dev/null || true)
        if [[ -n "$target_real" ]]; then
            [[ "$target_real" == /* ]] || target_real="$(cd "$(dirname "$target")" && pwd)/$target_real"
            if [[ "$target_real" == "$bashrc_real" || "$target_real" == "${HOME}/.bashrc" \
                || "$target_real" == *"init-files/bashrc" ]]; then
                log "OK       ${target/#$HOME/~} already resolves to init-files bashrc"
                return 0
            fi
        fi
    fi

    if [[ ! -e "$target" ]]; then
        printf '%s\n' "$block" > "$target" || return 1
        chmod 644 "$target" || true
        log "Created  ${target/#$HOME/~} to source ~/.bashrc on login"
        return 0
    fi

    if [[ ! -f "$target" ]]; then
        log "WARN     ${target/#$HOME/~} exists but is not a regular file; source ~/.bashrc from login shells manually"
        return 0
    fi

    if grep -Fq "$marker_begin" "$target" 2>/dev/null; then
        log "OK       ${target/#$HOME/~} already has init-files bashrc hook"
        return 0
    fi

    # Always append our marker. Do not skip just because a distro .profile
    # already has a conditional ". ~/.bashrc" — some hosts also have a
    # .bash_profile that shadows .profile without sourcing bashrc, and
    # bashrc itself ignores a second source in the same shell.
    printf '\n%s\n' "$block" >> "$target" || return 1
    log "Updated  ${target/#$HOME/~} to source ~/.bashrc on login shells"
}

