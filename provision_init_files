#!/usr/bin/env bash
# Provision init-files on this host: tools paths, bashrc/vimrc symlinks, SSH materials.
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"
src="$repo_dir/bashrc"
dest="${HOME}/.bashrc"
tools_dir="${XDG_CONFIG_HOME:-$HOME/.config}/init-files"
force=0
quiet=0
no_dev=0
dev_mode_explicit=0
github_https=0
github_transport_explicit=0
skip_iterm=0
init_files_state_dir="${init_files_state_dir:-${XDG_STATE_HOME:-$HOME/.local/state}/init-files}"
init_files_repo_https="${init_files_repo_https:-https://github.com/thehcma/init-files.git}"
init_files_repo_ssh="${init_files_repo_ssh:-git@github.com:thehcma/init-files.git}"

# Script error helpers (die/warn/log). Not for sourced bashrc.
if [[ ! -f "${repo_dir}/lib/error" ]]; then
    echo "ERROR: missing ${repo_dir}/lib/error (clone incomplete?)" >&2
    exit 1
fi
# shellcheck disable=SC1091
. "${repo_dir}/lib/error"

# Private config overlay (URL prompted / INIT_FILES_CONFIG_REPO; not hardcoded).
# shellcheck disable=SC1091
. "${repo_dir}/lib/config_paths"

# Hostname-scoped paths so NFS-shared homes (multiple short hostnames) can differ.
# Same host key as PS1 / bashrc: macOS ComputerName (not Bonjour LocalHostName).
_init_files_raw_host_label()
{
    local scutil_bin name
    if [[ "${OSTYPE:-}" == darwin* ]]; then
        scutil_bin="$(command -v scutil 2>/dev/null || true)"
        [[ -n "$scutil_bin" ]] || scutil_bin=/usr/sbin/scutil
        if [[ -x "$scutil_bin" ]]; then
            name="$("$scutil_bin" --get ComputerName 2>/dev/null || true)"
            if [[ -n "$name" ]]; then
                printf '%s\n' "$name"
                return 0
            fi
        fi
    fi
    hostname -s 2>/dev/null || hostname 2>/dev/null || echo host
}

_init_files_sanitize_host()
{
    local host="${1:-}"
    host="${host%%.*}"
    host="${host//[^A-Za-z0-9._-]/_}"
    [[ -n "$host" ]] || host="unknown-host"
    printf '%s\n' "$host"
}

init_files_host="$(_init_files_sanitize_host "$(_init_files_raw_host_label)")"

# When Bonjour LocalHostName differs (e.g. hostname-3 vs ComputerName),
# rename preference/tools files onto the ComputerName key so prefs are not orphaned.
# Also migrate hostname -s / -f scoped leftovers when they differ from init_files_host.
# Call after log() is defined.
_init_files_migrate_bonjour_scoped_files()
{
    local scutil_bin local_raw local_host prefix src dest tag
    local -a legacy_hosts=()

    mkdir -p "$tools_dir" 2>/dev/null || true

    if [[ "${OSTYPE:-}" == darwin* ]]; then
        scutil_bin="$(command -v scutil 2>/dev/null || true)"
        [[ -n "$scutil_bin" ]] || scutil_bin=/usr/sbin/scutil
        if [[ -x "$scutil_bin" ]]; then
            local_raw="$("$scutil_bin" --get LocalHostName 2>/dev/null || true)"
            if [[ -n "$local_raw" ]]; then
                local_host="$(_init_files_sanitize_host "$local_raw")"
                [[ "$local_host" != "$init_files_host" ]] && legacy_hosts+=("$local_host")
            fi
        fi
    fi

    tag="$(_init_files_sanitize_host "$(hostname -s 2>/dev/null || true)")"
    [[ -n "$tag" && "$tag" != "$init_files_host" ]] && legacy_hosts+=("$tag")
    tag="$(_init_files_sanitize_host "$(hostname -f 2>/dev/null || true)")"
    [[ -n "$tag" && "$tag" != "$init_files_host" ]] && legacy_hosts+=("$tag")

    for local_host in "${legacy_hosts[@]}"; do
        for prefix in no-dev github-https github-ssh fancy-prompt tools; do
            src="$tools_dir/${prefix}.${local_host}"
            dest="$tools_dir/${prefix}.${init_files_host}"
            if [[ -e "$src" && ! -e "$dest" ]]; then
                mv "$src" "$dest" 2>/dev/null || true
                if [[ -e "$dest" ]]; then
                    log "Migrated ${prefix}.${local_host} -> ${prefix}.${init_files_host}"
                fi
            fi
        done
    done
}

# Move ~/.local/opt/pipx/<legacy-hostname> onto init_files_host when needed.
_init_files_migrate_pipx_layout()
{
    local canonical src tag
    local -a legacy_tags=()

    canonical="${HOME}/.local/opt/pipx/${init_files_host}"
    [[ -x "$canonical/current/bin/pipx" ]] && return 0

    legacy_tags+=("$(hostname -f 2>/dev/null || true)")
    legacy_tags+=("$(hostname -s 2>/dev/null || true)")
    if [[ "${OSTYPE:-}" == darwin* ]]; then
        legacy_tags+=("$(scutil --get LocalHostName 2>/dev/null || true)")
    fi

    for tag in "${legacy_tags[@]}"; do
        [[ -n "$tag" ]] || continue
        tag="${tag//[^[:alnum:]._-]/-}"
        src="${HOME}/.local/opt/pipx/${tag}"
        [[ "$src" != "$canonical" ]] || continue
        [[ -x "$src/current/bin/pipx" ]] || continue
        mkdir -p "${HOME}/.local/opt/pipx" || return 0
        [[ -e "$canonical" ]] && return 0
        if mv "$src" "$canonical" 2>/dev/null; then
            log "Migrated pipx ${tag} -> ${init_files_host}"
            return 0
        fi
    done
    return 0
}

# Rebake pipx host wrapper if it still expands $init_tool_python3.
_init_files_rewrite_stale_pipx_wrapper()
{
    local py wrapper tools_py

    wrapper="${HOME}/.local/opt/pipx/${init_files_host}/current/bin/pipx"
    [[ -f "$wrapper" ]] || return 0
    grep -qE '\$\{?init_tool_python3\}?' "$wrapper" 2>/dev/null || return 0

    tools_py=
    if [[ -f "$tools_file" ]]; then
        # shellcheck disable=SC1090
        tools_py="$(grep -E '^init_tool_python3=' "$tools_file" 2>/dev/null | head -1 | cut -d= -f2- | tr -d \"\' || true)"
    fi
    py="${tools_py:-}"
    [[ -n "$py" && -x "$py" ]] || py="$(command -v python3 2>/dev/null || true)"
    [[ -n "$py" && -x "$py" ]] || {
        log "WARN     stale pipx wrapper at $wrapper but no python3 to rebake; run update_pipx after fixing python"
        return 0
    }

    cat > "$wrapper" <<EOF || return 0
#!/usr/bin/env bash
set -e

script_dir="\$(cd -- "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
site_dir="\${script_dir%/bin}/site"

export PYTHONPATH="\${site_dir}\${PYTHONPATH:+:\$PYTHONPATH}"
export PIPX_HOME="\$HOME/.local/share/pipx"
export PIPX_BIN_DIR="\$HOME/.local/bin"

exec env -u PIP_PREFIX $(printf '%q' "$py") -m pipx "\$@"
EOF
    chmod 775 "$wrapper" || true
    log "Rewrote stale pipx wrapper -> $wrapper"
}

usage()
{
    cat <<'EOF'
Usage: provision_init_files [-f|--force] [-q|--quiet] [--no-dev|--dev]
               [--github-https|--github-ssh] [-h|--help]

  Checks for tools the bashrc uses, writes absolute paths to
  ~/.config/init-files/tools.<hostname>, symlinks ~/.bashrc to this repo's
  bashrc, and installs shared + GitHub SSH materials from the private
  config overlay (~/.local/share/config/.ssh/) when present (authorized_keys
  merge, config.d snippets, git insteadOf rewrite unless this host prefers
  HTTPS).

  Homebrew paths are used only on modern macOS (26+ / Darwin 25+).
  On older macOS, brew is not recommended (unsupported formulae /
  multi-hour from-source builds) even if brew is installed.

  On modern macOS with a TTY (and without -q/--force), when required
  or optional tools are missing and have brew install hints, provision
  offers to install Homebrew (if needed), then required packages,
  then optional packages (two separate Y/n prompts). Formulae and
  casks are never mixed in one brew command; packages install one at
  a time so a single failure does not abort the rest. Required on
  modern macOS includes Homebrew bash and bash-completion@2 (Apple
  /bin/bash does not satisfy the bash requirement). Non-admin accounts
  get a cut-and-paste block for an admin instead of running brew.

  -f, --force   continue even if required tools are missing
  -q, --quiet   less status output (skips brew Y/n offers)
  --no-dev      do not require development tools (git, python3, make,
                patch, gdb, colordiff); still resolve
                them when present. Core shell tools (ssh, curl, vim,
                gpg, cmp) remain required. Remembers THIS host as
                non-dev (~/.config/init-files/no-dev.<hostname>) so
                NFS-shared homes can mix dev and non-dev boxes.
  --dev         require development tools again (clears this host's
                saved non-dev preference)
  --github-https
                use HTTPS for GitHub git (no SSH insteadOf). Remembers
                THIS host (~/.config/init-files/github-https.<hostname>).
                Also the default when gh is authenticated and SSH was not
                explicitly preferred (github-ssh.<hostname>).
  --github-ssh  use SSH for GitHub (insteadOf https→ssh). Remembers THIS
                host (~/.config/init-files/github-ssh.<hostname>) so gh
                auth does not auto-switch back to HTTPS.
  --no-iterm    on macOS, skip merging curated iTerm2 prefs (default: merge
                when not -q).
  --iterm       merge curated iTerm2 prefs on macOS (default when not -q;
                kept for compatibility).
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--force) force=1; shift ;;
        -q|--quiet) quiet=1; shift ;;
        --no-dev) no_dev=1; dev_mode_explicit=1; shift ;;
        --dev) no_dev=0; dev_mode_explicit=1; shift ;;
        --github-https) github_https=1; github_transport_explicit=1; shift ;;
        --github-ssh) github_https=0; github_transport_explicit=1; shift ;;
        --no-iterm) skip_iterm=1; shift ;;
        --iterm) skip_iterm=0; shift ;;
        -h|--help) usage; exit 0 ;;
        *)
            usage >&2
            init_files_die "unknown option: $1"
            ;;
    esac
done

log()
{
    init_files_log_quiet=$quiet
    init_files_log "$@"
}

# Migrate Bonjour-scoped prefs onto ComputerName, then resolve tools/flag paths.
_init_files_migrate_bonjour_scoped_files

# Prefer host-scoped tools; fall back to legacy unscoped names.
if [[ -n "${init_files_tools_file:-${INIT_FILES_TOOLS_FILE:-}}" ]]; then
    tools_file="${init_files_tools_file:-$INIT_FILES_TOOLS_FILE}"
elif [[ -f "$tools_dir/tools.${init_files_host}" ]]; then
    tools_file="$tools_dir/tools.${init_files_host}"
elif [[ -f "$tools_dir/tools" ]]; then
    tools_file="$tools_dir/tools"
elif [[ -f "$tools_dir/tools.sh" ]]; then
    tools_file="$tools_dir/tools.sh"
else
    tools_file="$tools_dir/tools.${init_files_host}"
fi

# Remembered --no-dev is per hostname (NFS-safe).
init_files_no_dev_flag="${init_files_no_dev_flag:-$tools_dir/no-dev.${init_files_host}}"
init_files_no_dev_flag_unscoped="${tools_dir}/no-dev"
init_files_no_dev_flag_legacy="${init_files_state_dir}/no-dev"
# Remembered GitHub transport (NFS-safe). Prefer HTTPS when gh is logged in
# unless github-ssh.<host> opts out. HTTPS uses `gh auth git-credential`
# (not osxkeychain). Note: insteadOf lives in ~/.gitconfig (shared on NFS) —
# last host to run install/apply wins for that rewrite; flags stay per-host.
init_files_github_https_flag="${init_files_github_https_flag:-$tools_dir/github-https.${init_files_host}}"
init_files_github_ssh_flag="${init_files_github_ssh_flag:-$tools_dir/github-ssh.${init_files_host}}"

# Honor a previously saved --no-dev preference when neither --dev nor --no-dev
# was passed. Prefer hostname-scoped flag (NFS-safe); migrate legacy unscoped
# / state flags onto this host only.
if [[ $dev_mode_explicit -eq 0 ]]; then
    if [[ ! -f "$init_files_no_dev_flag" ]]; then
        mkdir -p "$tools_dir" 2>/dev/null || true
        if [[ -f "$init_files_no_dev_flag_unscoped" ]]; then
            cp "$init_files_no_dev_flag_unscoped" "$init_files_no_dev_flag" 2>/dev/null || true
            # Drop unscoped so another NFS host is not forced into no-dev.
            rm -f "$init_files_no_dev_flag_unscoped" 2>/dev/null || true
            log "Migrated unscoped no-dev -> ${init_files_no_dev_flag/#$HOME/~}"
        elif [[ -f "$init_files_no_dev_flag_legacy" ]]; then
            mv "$init_files_no_dev_flag_legacy" "$init_files_no_dev_flag" 2>/dev/null \
                || cp "$init_files_no_dev_flag_legacy" "$init_files_no_dev_flag" 2>/dev/null \
                || true
            rm -f "$init_files_no_dev_flag_legacy" 2>/dev/null || true
            log "Migrated legacy no-dev -> ${init_files_no_dev_flag/#$HOME/~}"
        fi
    fi
    if [[ -f "$init_files_no_dev_flag" ]]; then
        no_dev=1
    fi
fi

# Transport when neither --github-https nor --github-ssh was passed:
# remembered HTTPS, else remembered SSH opt-out, else gh auth → HTTPS.
if [[ $github_transport_explicit -eq 0 ]]; then
    if [[ -f "$init_files_github_https_flag" ]]; then
        github_https=1
    elif [[ -f "$init_files_github_ssh_flag" ]]; then
        github_https=0
    else
        gh_bin="$(command -v gh 2>/dev/null || true)"
        if [[ -n "$gh_bin" && -x "$gh_bin" ]] && "$gh_bin" auth status >/dev/null 2>&1; then
            github_https=1
            log "GitHub: gh authenticated — preferring HTTPS on ${init_files_host}"
        fi
    fi
fi

persist_no_dev_preference()
{
    mkdir -p "$tools_dir" || return 0
    if [[ $no_dev -eq 1 ]]; then
        printf '1\n' > "$init_files_no_dev_flag" || true
        # Do not remove another host's scoped flag; only clear unscoped/legacy.
        rm -f "$init_files_no_dev_flag_unscoped" "$init_files_no_dev_flag_legacy" 2>/dev/null || true
        log "Mode: --no-dev (remembered for host ${init_files_host} in ${init_files_no_dev_flag/#$HOME/~})"
    else
        if [[ -f "$init_files_no_dev_flag" || -f "$init_files_no_dev_flag_unscoped" || -f "$init_files_no_dev_flag_legacy" ]]; then
            rm -f "$init_files_no_dev_flag" "$init_files_no_dev_flag_unscoped" "$init_files_no_dev_flag_legacy" || true
            log "Mode: full provision (cleared --no-dev preference for host ${init_files_host})"
        fi
    fi
}

persist_github_transport_preference()
{
    mkdir -p "$tools_dir" || return 0
    if [[ $github_https -eq 1 ]]; then
        printf '1\n' > "$init_files_github_https_flag" || true
        rm -f "$init_files_github_ssh_flag" 2>/dev/null || true
        log "GitHub: HTTPS (remembered for host ${init_files_host} in ${init_files_github_https_flag/#$HOME/~})"
    elif [[ $github_transport_explicit -eq 1 ]]; then
        # Explicit --github-ssh: remember opt-out so gh auth does not flip back.
        rm -f "$init_files_github_https_flag" 2>/dev/null || true
        printf '1\n' > "$init_files_github_ssh_flag" || true
        log "GitHub: SSH (remembered for host ${init_files_host} in ${init_files_github_ssh_flag/#$HOME/~})"
    else
        # Default SSH with no gh auth — leave any ssh opt-out alone; clear https.
        if [[ -f "$init_files_github_https_flag" ]]; then
            rm -f "$init_files_github_https_flag" || true
            log "GitHub: SSH (cleared github-https preference for host ${init_files_host})"
        else
            log "GitHub: SSH (insteadOf https→ssh)"
        fi
    fi
}

persist_no_dev_preference
persist_github_transport_preference

is_darwin()
{
    [[ "${OSTYPE:-}" == darwin* ]]
}

# macOS 26+ (Darwin 25+): the only macOS tier where Homebrew is supported.
is_modern_macos()
{
    local major
    is_darwin || return 1
    # Robust way to get macOS version: fallback to safer defaults
    major="$(uname -r 2>/dev/null || echo "0")"
    if [[ -n "$major" && "$major" != *[!0-9.]* ]]; then
        # Remove any non-numeric parts and take first number
        major="${major%%.*}"
        [[ "$major" =~ ^[0-9]+$ ]] || return 1
        (( major >= 25 ))
    else
        # Log warning for unexpected uname output, but fail gracefully
        # This prevents crashes on edge case systems while maintaining security
        log "WARNING: Unexpected uname -r output: '$major' (failing gracefully as non-modern macOS)"
        return 1
    fi
}

# Shared absolute-path verification (same rules as bashrc). Clean break: no
# legacy wrappers — call init_files_* from lib/tool_path only.
[[ -f "${repo_dir}/lib/tool_path" ]] \
    || init_files_die "missing ${repo_dir}/lib/tool_path (clone incomplete?)"
# repo_dir is resolved from this script at runtime.
# shellcheck disable=SC1091
. "${repo_dir}/lib/tool_path"
[[ -f "${repo_dir}/lib/host_paths" ]] \
    || init_files_die "missing ${repo_dir}/lib/host_paths (clone incomplete?)"
# shellcheck disable=SC1091
. "${repo_dir}/lib/host_paths"

# Thin alias — discovery lives in lib/host_paths.
homebrew_prefix()
{
    init_files_homebrew_prefix
}

resolve_tool()
{
    local candidate
    for candidate in "$@"; do
        [[ -n "$candidate" ]] || continue
        if init_files_verify_tool_path "$candidate"; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

resolve_from_path()
{
    local name="$1"
    local path
    path="$(command -v "$name" 2>/dev/null || true)"
    # Ignore shell aliases/functions; only absolute filesystem paths count.
    [[ -n "$path" && "$path" == /* ]] || return 1

    if init_files_verify_tool_path "$path"; then
        printf '%s\n' "$path"
        return 0
    fi
    return 1
}

brew_prefix=""
if is_modern_macos; then
    brew_prefix="$(homebrew_prefix || true)"
fi

# Bump when the record_tool set changes so refresh_init_files can detect drift.
# Keep in sync with INIT_FILES_TOOLS_REVISION in bashrc.
INIT_FILES_TOOLS_REVISION=11

declare -a REQUIRED_MISSING=()
declare -a OPTIONAL_MISSING=()
declare -a TOOL_EXPORTS=()

# Development tools: required by default; optional with --no-dev.
is_dev_tool()
{
    case "$1" in
        git|python3|make|patch|gdb|colordiff) return 0 ;;
        *) return 1 ;;
    esac
}

# record_tool NAME REQUIRED hint candidates...
# REQUIRED is "required" or "optional". With --no-dev, known dev tools
# are forced to optional so minimal hosts can still install bashrc.
#
# Why candidate lists differ by OS: modern macOS may record Homebrew absolutes;
# older macOS (Darwin < 25) rejects brew via lib/tool_path; Linux uses distro
# paths. Layout probes live in lib/host_paths. See AGENTS.md platform isolation
# and .cursor/rules/tool-path-consistency.mdc — do not merge OS tiers into one
# ungated PATH heuristic.
record_tool()
{
    local name="$1"
    local required="$2"
    local hint="$3"
    shift 3
    local path="" var

    if [[ $no_dev -eq 1 ]] && is_dev_tool "$name" && [[ "$required" == "required" ]]; then
        required="optional"
    fi

    path="$(resolve_tool "$@" || true)"
    if [[ -z "$path" ]]; then
        path="$(resolve_from_path "$name" || true)"
    fi

    # Modern macOS: Homebrew bash is mandatory. Reject Apple /bin/bash (and any
    # non-brew bash from PATH) so provision offers `brew install bash`.
    if [[ "$name" == "bash" ]] && is_modern_macos && [[ -n "$path" ]]; then
        case "$path" in
            */Cellar/bash/*|*/opt/bash/*)
                ;;
            *)
                if [[ -z "$brew_prefix" || "$path" != "$brew_prefix"/* ]]; then
                    path=""
                fi
                ;;
        esac
    fi

    # Final gate: never record a path that is not present/executable on this host.
    if [[ -n "$path" ]] && ! init_files_verify_tool_path "$path"; then
        log "  REJECT   ${name} -> ${path} (not an executable file on this host)"
        path=""
    fi

    var="init_tool_$(printf '%s' "$name" | tr '[:upper:]-' '[:lower:]_')"

    if [[ -n "$path" ]]; then
        TOOL_EXPORTS+=("${var}=${path}")
        log "  OK       ${name} -> ${path}"
    else
        TOOL_EXPORTS+=("${var}=")
        if [[ "$required" == "required" ]]; then
            REQUIRED_MISSING+=("$name|$hint")
            log "  MISSING  ${name} (required) — ${hint}"
        else
            OPTIONAL_MISSING+=("$name|$hint")
            if [[ $no_dev -eq 1 ]] && is_dev_tool "$name"; then
                log "  missing  ${name} (optional, --no-dev) — ${hint}"
            else
                log "  missing  ${name} (optional) — ${hint}"
            fi
        fi
    fi
}

# Parse a brew install hint into "formula:NAME" or "cask:NAME" on stdout.
# Prints nothing and fails for non-brew hints. Strips trailing comments.
# Never emit a bare "--cask NAME" token: Homebrew's --cask flag applies to
# *all* named args in one `brew install`, so mixing formulae + casks in a
# single command incorrectly treats formulae as casks.
brew_spec_from_hint()
{
    local hint="$1"
    local rest

    hint="${hint%%#*}"
    hint="${hint%"${hint##*[![:space:]]}"}"
    case "$hint" in
        "brew install --cask "*)
            rest="${hint#brew install --cask }"
            rest="${rest%%[[:space:]]*}"
            [[ -n "$rest" ]] || return 1
            printf 'cask:%s\n' "$rest"
            ;;
        "brew install "*)
            rest="${hint#brew install }"
            # Reject a misplaced --cask after "brew install " (should use the
            # --cask branch above). Avoid treating "--cask" as a formula name.
            case "$rest" in
                --cask|--cask\ *) return 1 ;;
            esac
            rest="${rest%%[[:space:]]*}"
            [[ -n "$rest" ]] || return 1
            printf 'formula:%s\n' "$rest"
            ;;
        *)
            return 1
            ;;
    esac
}

# True when a formula:NAME / cask:NAME brew spec is already installed (path check).
brew_spec_present()
{
    local spec="$1"

    case "$spec" in
        cask:*) brew_cask_present "${spec#cask:}" ;;
        formula:*) brew_formula_present "${spec#formula:}" ;;
        *) return 1 ;;
    esac
}

# Collect unique brew specs from name|hint entries (stdout, one per line).
# Skips specs already present under Cellar/Caskroom so we never Y/n-offer a
# no-op reinstall (e.g. font cask installed but file heuristics lagged).
brew_specs_from_missing()
{
    local entry hint spec out=""

    for entry in "$@"; do
        [[ -n "$entry" ]] || continue
        hint="${entry#*|}"
        spec="$(brew_spec_from_hint "$hint" || true)"
        [[ -n "$spec" ]] || continue
        brew_spec_present "$spec" && continue
        case $'\n'"$out"$'\n' in
            *$'\n'"$spec"$'\n'*) continue ;;
        esac
        out+="${spec}"$'\n'
    done
    printf '%s' "$out"
}

# Map a missing tool name to an apt package (Debian/Ubuntu). Empty → skip.
apt_package_for_tool()
{
    case "$1" in
        fzf) printf 'fzf\n' ;;
        bat) printf 'bat\n' ;;
        lsd) printf 'lsd\n' ;;
        rg) printf 'ripgrep\n' ;;
        *) return 1 ;;
    esac
}

# Collect unique apt packages from name|hint entries (stdout, one per line).
# Only emits packages for known shell-UX tools (fzf/bat/lsd/rg).
apt_packages_from_missing()
{
    local entry name pkg out=""

    for entry in "$@"; do
        [[ -n "$entry" ]] || continue
        name="${entry%%|*}"
        pkg="$(apt_package_for_tool "$name" || true)"
        [[ -n "$pkg" ]] || continue
        case $'\n'"$out"$'\n' in
            *$'\n'"$pkg"$'\n'*) continue ;;
        esac
        out+="${pkg}"$'\n'
    done
    printf '%s' "$out"
}

# Y/n prompt (default yes). Returns 0 on yes. No prompt under -q / non-TTY → no.
prompt_yn()
{
    local prompt="$1"
    local reply

    if [[ $quiet -eq 1 ]] || [[ ! -t 0 || ! -t 2 ]]; then
        return 1
    fi
    printf '%s ' "$prompt" >&2
    read -r reply || reply=n
    case "$reply" in
        ''|y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

refresh_brew_prefix()
{
    local brew_bin candidate

    brew_bin="$(command -v brew 2>/dev/null || true)"
    if [[ -z "$brew_bin" || ! -x "$brew_bin" ]]; then
        brew_bin=""
        while IFS= read -r candidate; do
            [[ -n "$candidate" && -x "$candidate" ]] || continue
            brew_bin="$candidate"
            break
        done < <(init_files_brew_bin_candidates)
    fi
    if [[ -n "$brew_bin" ]]; then
        # shellcheck disable=SC1090
        eval "$("$brew_bin" shellenv 2>/dev/null)" 2>/dev/null || true
        export PATH
    fi
    brew_prefix="$(homebrew_prefix || true)"
}

# Locate a brew binary if present (PATH or known prefixes). Prints path or nothing.
find_brew_bin()
{
    local brew_bin candidate

    brew_bin="$(command -v brew 2>/dev/null || true)"
    if [[ -z "$brew_bin" || ! -x "$brew_bin" ]]; then
        brew_bin=""
        while IFS= read -r candidate; do
            [[ -n "$candidate" && -x "$candidate" ]] || continue
            brew_bin="$candidate"
            break
        done < <(init_files_brew_bin_candidates)
    fi
    [[ -n "$brew_bin" && -x "$brew_bin" ]] || return 1
    printf '%s\n' "$brew_bin"
}

# True when brew exists and responds (prefix check), not merely when a shim is on PATH.
brew_is_usable()
{
    local brew_bin prefix

    brew_bin="$(find_brew_bin 2>/dev/null || true)"
    [[ -n "$brew_bin" && -x "$brew_bin" ]] || return 1
    prefix="$("$brew_bin" --prefix 2>/dev/null)" || return 1
    [[ -n "$prefix" && -d "$prefix" ]] || return 1
    return 0
}

# Human-readable brew install line for a formula:NAME / cask:NAME spec.
# Always use printf -- so a leading --cask in the format cannot be parsed as a flag.
brew_install_display()
{
    local spec="$1"
    case "$spec" in
        cask:*) printf -- 'brew install --cask %s\n' "${spec#cask:}" ;;
        formula:*) printf -- 'brew install %s\n' "${spec#formula:}" ;;
        *) printf -- 'brew install %s\n' "$spec" ;;
    esac
}

# True when this macOS account can administer the machine (admin group or root).
# Non-admins should not run the Homebrew installer / privileged brew steps —
# print copy-paste commands for an admin instead.
is_macos_admin()
{
    local user

    is_darwin || return 1
    [[ "$(id -u)" -eq 0 ]] && return 0

    user="$(id -un 2>/dev/null || true)"
    [[ -n "$user" ]] || return 1

    if command -v dseditgroup >/dev/null 2>&1; then
        dseditgroup -o checkmember -m "$user" admin >/dev/null 2>&1 && return 0
        return 1
    fi
    # Fallback when dseditgroup is unavailable.
    id -Gn 2>/dev/null | grep -qw admin
}

# Print a forwardable Homebrew handoff for IT / an admin (MDM non-admin Macs).
# Args: optional brew specs (formula:NAME / cask:NAME). When brew is missing,
# includes the official installer line first. See tool-path-consistency rule.
print_brew_admin_copy_paste()
{
    local -a specs=("$@")
    local spec need_bootstrap=0
    local user re_run host_label

    user="$(id -un 2>/dev/null || echo unknown)"
    re_run="${repo_dir:-$HOME/.local/share/init-files}/provision_init_files"
    host_label=""
    if [[ -x /usr/sbin/scutil ]]; then
        host_label="$(/usr/sbin/scutil --get ComputerName 2>/dev/null || true)"
    fi
    [[ -n "$host_label" ]] || host_label="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo unknown-host)"

    # Need Homebrew installer when brew is missing or does not respond (--prefix).
    brew_is_usable || need_bootstrap=1

    printf -- '\n' >&2
    printf -- '----------------------------------------------------------------------\n' >&2
    printf -- 'ADMIN HANDOFF — MDM / non-admin macOS account\n' >&2
    printf -- 'Host:  %s\n' "$host_label" >&2
    printf -- 'User:  %s (not in the admin group — cannot run brew installs)\n' "$user" >&2
    printf -- '\n' >&2
    printf -- 'Non-admin: forward this entire block to IT / a macOS administrator.\n' >&2
    printf -- 'Admin: run the commands below in Terminal ON THIS MAC, then tell the\n' >&2
    printf -- 'user to re-run (as themselves, no sudo):\n' >&2
    printf -- '  %s\n' "$re_run" >&2
    printf -- '\n' >&2
    if [[ $need_bootstrap -eq 1 ]]; then
        printf -- '# 1) Install Homebrew (admin password / MDM approval may be required)\n' >&2
        # Print the installer command without executing substitutions.
        # shellcheck disable=SC2016
        printf -- '%s\n' '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"' >&2
        # Print the shellenv example literally for the administrator.
        # shellcheck disable=SC2016
        printf -- '%s\n' '# After install, follow the "Next steps" it prints (eval "$(...shellenv)"), then:' >&2
        printf -- '\n' >&2
    fi
    if ((${#specs[@]} > 0)); then
        if [[ $need_bootstrap -eq 1 ]]; then
            printf -- '# 2) Install packages (one line each; do not mix --cask with formulae)\n' >&2
        else
            printf -- '# Install packages (one line each; do not mix --cask with formulae)\n' >&2
        fi
        for spec in "${specs[@]}"; do
            brew_install_display "$spec" >&2
        done
        printf -- '\n' >&2
    fi
    printf -- '# User-local installs (nvm Node, Meslo font zip) do NOT need admin — skip those.\n' >&2
    printf -- '----------------------------------------------------------------------\n' >&2
}

# Offer official Homebrew bootstrap on modern macOS when brew is missing.
# Returns 0 when brew is usable afterward.
offer_homebrew_bootstrap()
{
    local brew_bin

    refresh_brew_prefix
    if brew_is_usable; then
        return 0
    fi

    # No interactive offer under -q / non-TTY.
    if [[ $quiet -eq 1 ]] || [[ ! -t 0 || ! -t 2 ]]; then
        return 1
    fi

    echo "Homebrew is not installed or not usable (needed for missing tools on modern macOS)." >&2
    if ! is_macos_admin; then
        # Non-admin: handoff is emitted once via ensure_brew_admin_handoff.
        echo "Skipped Homebrew install (not an admin on this Mac)." >&2
        return 1
    fi
    if ! prompt_yn "Install Homebrew now? [Y/n]"; then
        echo "Skipped Homebrew install." >&2
        return 1
    fi
    if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        init_files_warn "Homebrew install failed"
        return 1
    fi
    refresh_brew_prefix
    brew_is_usable
}

# Install one brew spec (formula:NAME or cask:NAME). Returns brew's exit status.
brew_install_one()
{
    local brew_bin="$1"
    local spec="$2"
    local name

    case "$spec" in
        cask:*)
            name="${spec#cask:}"
            [[ -n "$name" ]] || return 1
            "$brew_bin" install --cask "$name"
            ;;
        formula:*)
            name="${spec#formula:}"
            [[ -n "$name" ]] || return 1
            # Explicit --formula so a future accidental cask-named collision
            # cannot flip the whole batch (and documents intent).
            "$brew_bin" install --formula "$name"
            ;;
        *)
            return 1
            ;;
    esac
}

# Offer brew install for a kind (required|optional). Args: kind, then brew specs
# (formula:NAME / cask:NAME). Formulae and casks are never mixed in one brew
# invocation. Packages are installed one-by-one so a single failure does not
# abort the rest. Returns 0 if at least one install succeeded (caller should
# rediscover); 1 if skipped, brew missing, or every install failed.
offer_brew_packages()
{
    local kind="$1"
    shift
    local -a specs=("$@")
    local spec brew_bin
    local ok=0 fail=0

    ((${#specs[@]} > 0)) || return 1

    # No interactive offer under -q / non-TTY (print_install_suggestions still runs).
    if [[ $quiet -eq 1 ]] || [[ ! -t 0 || ! -t 2 ]]; then
        return 1
    fi

    printf '\nMissing %s Homebrew packages:\n' "$kind" >&2
    for spec in "${specs[@]}"; do
        printf '  ' >&2
        brew_install_display "$spec" >&2
    done

    if ! is_macos_admin; then
        # Non-admin: consolidated copy-paste is printed by maybe_offer_brew_for_missing.
        echo "Skipped ${kind} Homebrew packages (not an admin on this Mac)." >&2
        return 1
    fi

    if ! prompt_yn "Install ${#specs[@]} ${kind} Homebrew package(s)? [Y/n]"; then
        echo "Skipped ${kind} Homebrew packages." >&2
        return 1
    fi

    brew_bin="$(find_brew_bin 2>/dev/null || true)"
    if [[ -z "$brew_bin" ]] || ! brew_is_usable; then
        init_files_warn "brew not found or not usable after bootstrap"
        return 1
    fi

    for spec in "${specs[@]}"; do
        printf '\n→ %s' "$(brew_install_display "$spec")" >&2
        if brew_install_one "$brew_bin" "$spec"; then
            ok=1
        else
            fail=1
            echo "WARNING: brew install failed for: $(brew_install_display "$spec" | tr -d '\n')" >&2
        fi
    done

    refresh_brew_prefix

    if [[ $fail -eq 1 ]]; then
        init_files_warn "some ${kind} Homebrew package(s) failed to install"
    fi
    # Rediscover whenever anything landed, even if other packages failed.
    [[ $ok -eq 1 ]]
}

