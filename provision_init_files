# ~/.bashrc is a symlink into the clone so refresh_init_files only needs to git pull.
link_bashrc_to_repo()
{
    local current

    if [[ ! -f "$src" ]]; then
        init_files_warn "missing $src"
        return 1
    fi

    if [[ -L "$dest" ]]; then
        current=$(readlink "$dest" 2>/dev/null || true)
        if [[ "$current" == "$src" ]]; then
            log "OK       ~/.bashrc -> $src"
            return 0
        fi
        log "Replacing symlink ~/.bashrc ($current) -> $src"
        rm -f "$dest" || return 1
    elif [[ -e "$dest" ]]; then
        if [[ ! -f "$dest" ]]; then
            init_files_warn "$dest exists and is not a regular file or symlink"
            return 1
        fi
        backup="${dest}.bak.$(date +%Y%m%d-%H%M%S)"
        cp -p "$dest" "$backup" || return 1
        log "Backed up existing ~/.bashrc -> $backup"
        rm -f "$dest" || return 1
    fi

    ln -s "$src" "$dest" || return 1
    log "Linked   ~/.bashrc -> $src"
}

