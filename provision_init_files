# OpenSSH option so RSA keys can auth to GitHub (needed on some 8.x / FIPS hosts).
github_ssh_rsa_sha2_line()
{
    local ver major=0 minor=0

    ver=$(ssh -V 2>&1 || true)
    if [[ "$ver" =~ OpenSSH_([0-9]+)\.([0-9]+) ]]; then
        major="${BASH_REMATCH[1]}"
        minor="${BASH_REMATCH[2]}"
    fi
    if (( major > 8 || (major == 8 && minor >= 5) )); then
        printf '    PubkeyAcceptedAlgorithms rsa-sha2-512,rsa-sha2-256\n'
    else
        printf '    PubkeyAcceptedKeyTypes rsa-sha2-512,rsa-sha2-256\n'
    fi
}

# Install GitHub Host block with absolute IdentityFiles for keys that exist.
# Never list a missing IdentityFile (IdentitiesOnly + missing path aborts auth on
# some OpenSSH builds before later keys are tried).
install_github_ssh_snippet()
{
    local -a ids=()
    local id dest_tmp need_rsa=0

    ensure_ssh_config_include || return 1
    mkdir -p "$ssh_config_d" || return 1

    if [[ ! -f "$ssh_github_config_src" ]]; then
        log "SKIP     GitHub SSH snippet (missing ${ssh_github_config_src/#$HOME/~})"
        return 0
    fi

    while IFS= read -r id || [[ -n "$id" ]]; do
        [[ -n "$id" ]] && ids+=("$id")
    done < <(init_files_github_identity_files_from_template "$ssh_github_config_src")

    if ((${#ids[@]} == 0)); then
        log "WARN     no GitHub SSH keys on disk; skip ${ssh_github_snippet/#$HOME/~}"
        return 0
    fi

    dest_tmp=$(mktemp) || return 1
    need_rsa=0
    for id in "${ids[@]}"; do
        if declare -F init_files_ssh_key_is_rsa > /dev/null 2>&1 && init_files_ssh_key_is_rsa "$id"; then
            need_rsa=1
            break
        fi
        case "$(basename -- "$id")" in
            id_rsa|id_rsa_*) need_rsa=1; break ;;
        esac
    done
    {
        printf '%s\n' \
            '# Managed by init-files (from private config .ssh/config.github; keys filtered).' \
            '' \
            'Host github.com' \
            '    HostName github.com' \
            '    User git'
        for id in "${ids[@]}"; do
            printf '    IdentityFile %s\n' "$id"
        done
        if [[ $need_rsa -eq 1 ]]; then
            github_ssh_rsa_sha2_line
        fi
        printf '%s\n' '    IdentitiesOnly yes' '    VisualHostKey no'
    } > "$dest_tmp"

    if [[ -f "$ssh_github_snippet" ]] && cmp -s "$dest_tmp" "$ssh_github_snippet" 2>/dev/null; then
        rm -f "$dest_tmp"
        log "OK       ${ssh_github_snippet/#$HOME/~}"
        return 0
    fi
    mv "$dest_tmp" "$ssh_github_snippet" || {
        rm -f "$dest_tmp"
        return 1
    }
    chmod 600 "$ssh_github_snippet" || true
    log "Installed ${ssh_github_snippet/#$HOME/~}"
}

install_shared_authorized_keys()
{
    local line keyblob tmp existing
    local added=0

    [[ -n "$ssh_auth_src" && -f "$ssh_auth_src" ]] || {
        log "SKIP     shared authorized_keys (missing overlay authorized_keys.shared)"
        return 0
    }

    mkdir -p "$ssh_dir" || return 1
    chmod 700 "$ssh_dir" || true
    touch "$ssh_auth_file" || return 1
    chmod 600 "$ssh_auth_file" || true

    existing=$(cat "$ssh_auth_file" 2>/dev/null || true)
    tmp=$(mktemp) || return 1
    printf '%s\n' "$existing" > "$tmp"

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" != \#* ]] || continue
        # Compare on the key material (field 2) so comment changes do not duplicate.
        keyblob=$(printf '%s\n' "$line" | awk '{print $2}')
        [[ -n "$keyblob" ]] || continue
        if grep -qF -- "$keyblob" "$tmp" 2>/dev/null; then
            continue
        fi
        printf '%s\n' "$line" >> "$tmp"
        added=$((added + 1))
    done < "$ssh_auth_src"

    if [[ $added -gt 0 ]]; then
        cp "$tmp" "$ssh_auth_file" || {
            rm -f "$tmp"
            return 1
        }
        chmod 600 "$ssh_auth_file" || true
        log "Updated  ~/.ssh/authorized_keys (+$added shared key(s))"
    else
        log "OK       ~/.ssh/authorized_keys (shared keys already present)"
    fi
    rm -f "$tmp"
}

ensure_ssh_config_include()
{
    # Prefer ~/.ssh/... so relative Includes are not cwd-based. Eternal Terminal
    # (et 7) aborts on relative Include config.d/*.conf when cwd ≠ ~/.ssh
    # (MisterTea/EternalTerminal#747). OpenSSH accepts the tilde form.
    local include_line='Include ~/.ssh/config.d/*.conf'
    local tmp

    mkdir -p "$ssh_config_d" || return 1
    chmod 700 "$ssh_dir" || true

    if [[ ! -f "$ssh_config_file" ]]; then
        printf '%s\n' "$include_line" > "$ssh_config_file" || return 1
        chmod 600 "$ssh_config_file" || true
        log "Created  ~/.ssh/config with Include ~/.ssh/config.d/*.conf"
        return 0
    fi

    if grep -Eq '^[[:space:]]*Include[[:space:]]+~/\.ssh/config\.d/\*\.conf[[:space:]]*$' "$ssh_config_file"; then
        return 0
    fi

    # Migrate legacy relative Include (OpenSSH-ok, et-abort) → tilde form.
    if grep -Eq '^[[:space:]]*Include[[:space:]]+config\.d/\*\.conf[[:space:]]*$' "$ssh_config_file"; then
        tmp=$(mktemp) || return 1
        sed -E 's|^([[:space:]]*Include[[:space:]]+)config\.d/\*\.conf([[:space:]]*)$|\1~/.ssh/config.d/*.conf\2|' \
            "$ssh_config_file" > "$tmp" || {
            rm -f "$tmp"
            return 1
        }
        cp "$tmp" "$ssh_config_file" || {
            rm -f "$tmp"
            return 1
        }
        rm -f "$tmp"
        chmod 600 "$ssh_config_file" || true
        log "Updated  ~/.ssh/config Include → ~/.ssh/config.d/*.conf (et-safe)"
        return 0
    fi

    # Prepend Include so shared/GitHub Host blocks are seen before a catch-all Host *.
    tmp=$(mktemp) || return 1
    {
        printf '%s\n\n' "$include_line"
        cat "$ssh_config_file"
    } > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    cp "$tmp" "$ssh_config_file" || {
        rm -f "$tmp"
        return 1
    }
    rm -f "$tmp"
    chmod 600 "$ssh_config_file" || true
    log "Prepended Include ~/.ssh/config.d/*.conf to ~/.ssh/config"
}

install_ssh_config_snippet()
{
    local src_file="$1"
    local dest_file="$2"
    local label="$3"

    [[ -f "$src_file" ]] || {
        log "SKIP     ${label} (missing $src_file)"
        return 0
    }

    ensure_ssh_config_include || return 1
    mkdir -p "$ssh_config_d" || return 1

    if [[ -f "$dest_file" ]] && cmp -s "$src_file" "$dest_file" 2>/dev/null; then
        log "OK       ${dest_file/#$HOME/~}"
        return 0
    fi

    cp "$src_file" "$dest_file" || return 1
    chmod 600 "$dest_file" || true
    log "Installed ${dest_file/#$HOME/~}"
}

ensure_github_known_hosts()
{
    local known="${ssh_dir}/known_hosts"

    mkdir -p "$ssh_dir" || return 1
    touch "$known" || return 1
    chmod 600 "$known" || true

    if grep -qE '^(github\.com|[0-9.]+\s+.*github)' "$known" 2>/dev/null \
        || grep -q ' github.com ' "$known" 2>/dev/null
    then
        return 0
    fi

    if command -v ssh-keyscan > /dev/null 2>&1; then
        ssh-keyscan -t ed25519,rsa github.com >> "$known" 2>/dev/null || true
        if grep -q 'github.com' "$known" 2>/dev/null; then
            log "Added    github.com to ~/.ssh/known_hosts"
        else
            log "WARN     could not ssh-keyscan github.com (check later with: ssh -T git@github.com)"
        fi
    fi
}

ensure_github_https_credentials()
{
    # Use `gh auth git-credential` for GitHub HTTPS. Seeding osxkeychain caused
    # repeated Keychain ACL dialogs (get+store per git op), especially from
    # non-Terminal parents (Cursor/agent). Shared helper in lib/config_paths.
    local git_bin="${1:-}"
    local gh_bin
    local gh_helper='!gh auth git-credential'

    gh_bin="$(command -v gh 2>/dev/null || true)"
    [[ -n "$gh_bin" && -x "$gh_bin" ]] || {
        log "WARN     gh not on PATH; HTTPS git may prompt for credentials"
        log "         Install gh, then: gh auth login && provision_init_files --github-https"
        return 0
    }
    if ! "$gh_bin" auth status >/dev/null 2>&1; then
        log "WARN     gh not logged in; run: gh auth login && provision_init_files --github-https"
        return 0
    fi

    if declare -F init_files_configure_gh_git_credential > /dev/null 2>&1; then
        if init_files_configure_gh_git_credential; then
            log "OK       GitHub HTTPS via gh auth git-credential"
            return 0
        fi
        log "WARN     failed to configure gh auth git-credential"
        return 0
    fi

    # Fallback if config_paths was not sourced (should not happen in provision).
    "$git_bin" config --global --unset-all credential.https://github.com.helper 2>/dev/null || true
    "$git_bin" config --global --unset-all credential.https://gist.github.com.helper 2>/dev/null || true
    "$git_bin" config --global --add credential.https://github.com.helper '' || true
    "$git_bin" config --global --add credential.https://github.com.helper "$gh_helper" || true
    "$git_bin" config --global --add credential.https://gist.github.com.helper '' || true
    "$git_bin" config --global --add credential.https://gist.github.com.helper "$gh_helper" || true
    log "OK       GitHub HTTPS via gh auth git-credential"
}

ensure_github_git_transport()
{
    local git_bin existing desired_remote configured

    git_bin="$(command -v git 2>/dev/null || true)"
    [[ -n "$git_bin" && -x "$git_bin" ]] || {
        log "SKIP     git GitHub transport (git not on PATH; install git then re-run provision_init_files)"
        return 0
    }

    if [[ $github_https -eq 1 ]]; then
        existing=$("$git_bin" config --global --get "url.${github_insteadof_to}.insteadof" 2>/dev/null || true)
        if [[ -n "$existing" ]]; then
            "$git_bin" config --global --unset-all "url.${github_insteadof_to}.insteadOf" 2>/dev/null || true
            log "Cleared  git url.${github_insteadof_to}.insteadOf (HTTPS preferred on ${init_files_host})"
        else
            log "OK       no https→ssh insteadOf (HTTPS preferred on ${init_files_host})"
        fi
        "$git_bin" config --global --unset-all core.sshCommand 2>/dev/null || true
        ensure_github_https_credentials "$git_bin"
        desired_remote="$init_files_repo_https"
    else
        existing=$("$git_bin" config --global --get "url.${github_insteadof_to}.insteadof" 2>/dev/null || true)
        if [[ "$existing" == "$github_insteadof_from" ]]; then
            log "OK       git url.${github_insteadof_to}.insteadOf -> ${github_insteadof_from}"
        else
            if "$git_bin" config --global "url.${github_insteadof_to}.insteadOf" "$github_insteadof_from"; then
                log "Set      git url.${github_insteadof_to}.insteadOf ${github_insteadof_from}"
            else
                log "WARN     failed to set git insteadOf for GitHub SSH"
            fi
        fi
        # Never prompt for passphrase/askpass during git; fail fast if key not loaded.
        if "$git_bin" config --global core.sshCommand "ssh -o BatchMode=yes -o ConnectTimeout=10"; then
            log "Set      git core.sshCommand BatchMode (no passphrase prompts)"
        fi
        # Keep a documented HTTPS remote; insteadOf rewrites operations to SSH.
        desired_remote="$init_files_repo_https"
    fi

    if [[ -d "$repo_dir/.git" ]]; then
        configured=$("$git_bin" -C "$repo_dir" config --get remote.origin.url 2>/dev/null || true)
        if [[ -n "$desired_remote" && "$configured" != "$desired_remote" ]]; then
            "$git_bin" -C "$repo_dir" remote set-url origin "$desired_remote" >/dev/null 2>&1 || true
            log "Set      init-files origin -> $desired_remote"
        fi
    fi
}

warn_if_github_key_missing()
{
    local id

    if [[ $github_https -eq 1 ]]; then
        log "OK       GitHub HTTPS mode (SSH key optional for git on ${init_files_host})"
        return 0
    fi
    if [[ ! -f "$ssh_github_config_src" ]]; then
        return 0
    fi
    while IFS= read -r id || [[ -n "$id" ]]; do
        [[ -n "$id" ]] || continue
        log "OK       GitHub SSH key present (${id/#$HOME/~})"
        return 0
    done < <(init_files_github_identity_files_from_template "$ssh_github_config_src")
    log "WARN     no GitHub SSH keys from ${ssh_github_config_src/#$HOME/~} on this host"
    log "         Copy a GitHub-registered key, then: cache_ssh && ssh -T git@github.com"
    log "         Or: provision_init_files --github-https if this host uses gh/HTTPS instead."
}

