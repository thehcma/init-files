# True when a Homebrew formula is linked/installed — path check only.
# Never use `brew list` here: it walks Cellar (can hang for minutes on large
# formulae like bash-completion@2) and blocks interactive check_tool_versions.
brew_formula_present()
{
    local name="$1"
    local prefix="${2:-${brew_prefix:-}}"

    [[ -n "$name" ]] || return 1
    if [[ -z "$prefix" ]]; then
        prefix="$(homebrew_prefix 2>/dev/null || true)"
    fi
    [[ -n "$prefix" ]] || return 1
    [[ -e "$prefix/opt/$name" || -d "$prefix/Cellar/$name" ]]
}

# True when a Homebrew cask is installed — Caskroom path check only (no brew list).
brew_cask_present()
{
    local name="$1"
    local prefix="${2:-${brew_prefix:-}}"

    [[ -n "$name" ]] || return 1
    if [[ -z "$prefix" ]]; then
        prefix="$(homebrew_prefix 2>/dev/null || true)"
    fi
    [[ -n "$prefix" ]] || return 1
    [[ -d "$prefix/Caskroom/$name" ]]
}

# True when Meslo LGS Nerd Font is usable for THIS user (readable font files).
# Do not treat a Homebrew cask owned by another account as installed — Caskroom
# entries are often symlinks into that owner's ~/Library/Fonts (unreadable here).
meslo_nerd_font_installed()
{
    local dir f
    local -a dirs=()

    dirs=("${HOME}/Library/Fonts" "/Library/Fonts")

    for dir in "${dirs[@]}"; do
        [[ -d "$dir" ]] || continue
        # Prefer the Mono Regular file the curated iTerm profile uses.
        for f in \
            "$dir/MesloLGSNerdFontMono-Regular.ttf" \
            "$dir/MesloLGSNerdFontMono-Regular.otf" \
            "$dir/MesloLGSNFM-Regular.ttf" \
            "$dir/MesloLGSNFM-Regular.otf" \
            "$dir/MesloLGS Nerd Font Mono.ttf"
        do
            [[ -r "$f" ]] && return 0
        done
        # Any readable Meslo LGS Nerd Font face is enough for the optional offer;
        # iterm2 check-fonts does the precise PostScript match later.
        if compgen -G "$dir/MesloLGS*NerdFont*.ttf" > /dev/null 2>&1 \
            || compgen -G "$dir/MesloLGS*NerdFont*.otf" > /dev/null 2>&1 \
            || compgen -G "$dir/MesloLGS*NFM*.ttf" > /dev/null 2>&1 \
            || compgen -G "$dir/MesloLGS NF*.ttf" > /dev/null 2>&1
        then
            # Ensure at least one match is readable (not a dangling/other-user link).
            for f in "$dir"/MesloLGS*NerdFont*.ttf "$dir"/MesloLGS*NerdFont*.otf \
                "$dir"/MesloLGS*NFM*.ttf "$dir"/MesloLGS\ NF*.ttf
            do
                [[ -r "$f" ]] && return 0
            done
        fi
    done
    return 1
}

