# Resolve recorded init_tool_bash from TOOL_EXPORTS (absolute brew path when present).
provision_recorded_bash()
{
    local entry
    for entry in "${TOOL_EXPORTS[@]+"${TOOL_EXPORTS[@]}"}"; do
        [[ "$entry" == init_tool_bash=* ]] || continue
        printf '%s\n' "${entry#init_tool_bash=}"
        return 0
    done
    return 1
}

bash_paths_same_file()
{
    local left="$1" right="$2"
    local left_real right_real

    [[ -n "$left" && -n "$right" ]] || return 1
    [[ "$left" == "$right" ]] && return 0
    [[ -e "$left" && -e "$right" ]] || return 1

    if command -v python3 > /dev/null 2>&1; then
        python3 -c 'import os,sys; raise SystemExit(0 if os.path.samefile(sys.argv[1], sys.argv[2]) else 1)' \
            "$left" "$right" 2>/dev/null
        return
    fi
    left_real=$(init_files_resolve_realpath "$left" 2>/dev/null || printf '%s' "$left")
    right_real=$(init_files_resolve_realpath "$right" 2>/dev/null || printf '%s' "$right")
    [[ "$left_real" == "$right_real" ]]
}

print_brew_bash_login_shell_tip()
{
    local preferred cellar current_shell

    [[ $quiet -eq 1 ]] && return 0
    is_modern_macos || return 0

    preferred="$(provision_recorded_bash 2>/dev/null || true)"
    [[ -n "$preferred" && -x "$preferred" ]] || return 0

    cellar="$(init_files_resolve_realpath "$preferred" 2>/dev/null || printf '%s' "$preferred")"
    [[ -n "$cellar" && -x "$cellar" ]] || cellar="$preferred"

    current_shell=
    if command -v dscl > /dev/null 2>&1; then
        current_shell="$(dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null \
            | awk '{ print $2; exit }' || true)"
    fi
    [[ -n "$current_shell" ]] || current_shell="${SHELL:-}"

    if [[ -n "$current_shell" ]] && bash_paths_same_file "$current_shell" "$cellar"; then
        log "OK       login shell already Homebrew bash ($current_shell)"
        return 0
    fi

    cat <<EOF

To use Homebrew bash as your login shell (Apple /bin/bash is 3.2.x):
  1. Add the Cellar path to /etc/shells (chpass wants a regular file, not the brew bin symlink):
       $cellar
     (or: grep -qxF $cellar /etc/shells || echo $cellar | sudo tee -a /etc/shells)
  2. chsh -s $cellar
  3. Quit and reopen the terminal (Default login shell)

Note: /opt/homebrew/bin/bash is only a symlink; chsh to the Cellar path above.
If chsh rejects your Full Name field, remove commas from that GECOS field (or use System Settings → Users), then retry.
EOF
}

