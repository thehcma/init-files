gvimrc_dest="${HOME}/.gvimrc"
vim_plug_url='https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
vim_plug_path="${HOME}/.vim/autoload/plug.vim"
vim_backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/init-files/vim-backup"

_init_files_vim_bin()
{
    local v
    if [[ -n "${init_tool_vim:-}" && -x "${init_tool_vim}" ]]; then
        printf '%s' "$init_tool_vim"
        return 0
    fi
    # tools file may not be sourced in this script — read recorded path if present.
    if [[ -r "$tools_file" ]]; then
        v=$(awk -F= '$1 == "init_tool_vim" { print $2; exit }' "$tools_file" 2>/dev/null || true)
        if [[ -n "$v" && -x "$v" ]]; then
            printf '%s' "$v"
            return 0
        fi
    fi
    command -v vim 2>/dev/null || return 1
}

_init_files_is_modern_macos()
{
    local major
    [[ "${OSTYPE:-}" == darwin* ]] || return 1
    major="$(uname -r 2>/dev/null | cut -d. -f1)"
    [[ "$major" =~ ^[0-9]+$ ]] || return 1
    (( major >= 25 ))
