# Modern macOS: offer Homebrew bootstrap + required then optional packages.
# Rediscover after required installs *before* optional, so a later optional
# failure cannot leave required tools looking missing. No-ops on older macOS /
# Linux, --force, or when nothing brew-installable is missing.
# Non-admin accounts never run brew installs — print cut-and-paste for an admin.
maybe_offer_brew_for_missing()
{
    local -a req_specs=() opt_specs=()
    local line

    is_modern_macos || return 0
    [[ $force -eq 0 ]] || return 0

    while IFS= read -r line; do
        [[ -n "$line" ]] && req_specs+=("$line")
    done < <(brew_specs_from_missing "${REQUIRED_MISSING[@]+"${REQUIRED_MISSING[@]}"}")

    while IFS= read -r line; do
        [[ -n "$line" ]] && opt_specs+=("$line")
    done < <(brew_specs_from_missing "${OPTIONAL_MISSING[@]+"${OPTIONAL_MISSING[@]}"}")

    ((${#req_specs[@]} + ${#opt_specs[@]} > 0)) || return 0

    if ! is_macos_admin; then
        # Non-admin / MDM: do not prompt or run brew. Handoff is emitted once
        # later via ensure_brew_admin_handoff (see print_install_suggestions).
        return 0
    fi

    if ! offer_homebrew_bootstrap; then
        return 0
    fi

    if ((${#req_specs[@]} > 0)); then
        if offer_brew_packages required "${req_specs[@]}"; then
            log
            log "Re-checking tools after required Homebrew install..."
            discover_tools
            verify_discovered_tools
            # Refresh optional list in case required installs pulled deps.
            opt_specs=()
            while IFS= read -r line; do
                [[ -n "$line" ]] && opt_specs+=("$line")
            done < <(brew_specs_from_missing "${OPTIONAL_MISSING[@]+"${OPTIONAL_MISSING[@]}"}")
        fi
    fi
    if ((${#opt_specs[@]} > 0)); then
        if offer_brew_packages optional "${opt_specs[@]}"; then
            log
            log "Re-checking tools after optional Homebrew install..."
            discover_tools
            verify_discovered_tools
        fi
    fi
}

# Linux (Debian/Ubuntu): offer apt install for optional shell-UX packages.
# Rediscover after a successful install. No-ops without apt-get, on Darwin,
# --force, -q / non-TTY, or when nothing apt-installable is missing.
maybe_offer_apt_for_missing()
{
    local -a pkgs=()
    local line

    is_darwin && return 0
    command -v apt-get > /dev/null 2>&1 || return 0
    [[ $force -eq 0 ]] || return 0

    while IFS= read -r line; do
        [[ -n "$line" ]] && pkgs+=("$line")
    done < <(apt_packages_from_missing "${OPTIONAL_MISSING[@]+"${OPTIONAL_MISSING[@]}"}")

    ((${#pkgs[@]} > 0)) || return 0

    if [[ $quiet -eq 1 ]] || [[ ! -t 0 || ! -t 2 ]]; then
        return 0
    fi

    printf '\nMissing optional apt packages (fzf / bat / lsd / ripgrep):\n' >&2
    for line in "${pkgs[@]}"; do
        printf '  sudo apt install %s\n' "$line" >&2
    done

    if ! prompt_yn "Install ${#pkgs[@]} optional apt package(s)? [Y/n]"; then
        echo "Skipped optional apt packages." >&2
        return 0
    fi

    if ! sudo apt-get update || ! sudo apt-get install -y "${pkgs[@]}"; then
        echo "WARNING: apt install reported failure for optional packages" >&2
        return 0
    fi

    log
    log "Re-checking tools after apt install..."
    discover_tools
    verify_discovered_tools
}

# Darwin/Linux: offer user-local Meslo.zip install when the curated font is missing.
# No sudo — writes only under the current user's font directory.
maybe_offer_meslo_user_font()
{
    local helper entry name
    local need=0

    [[ $quiet -eq 1 || $force -eq 1 ]] && return 0
    [[ -t 0 && -t 2 ]] || return 0

    helper="${repo_dir}/iterm2/install_meslo_nerd_font"
    [[ -x "$helper" ]] || return 0

    if meslo_nerd_font_installed 2>/dev/null; then
        return 0
    fi

    # Only offer when we recorded it missing (Darwin), or always when missing on Linux
    # with a GUI/font need — keep it to Darwin + when listed optional for now.
    for entry in "${OPTIONAL_MISSING[@]+"${OPTIONAL_MISSING[@]}"}"; do
        name="${entry%%|*}"
        if [[ "$name" == "meslo-nerd-font" || "$name" == "font-meslo-lg-nerd-font" ]]; then
            need=1
            break
        fi
    done
    # If discover already ran and font is missing on Darwin even without OPTIONAL entry.
    if [[ $need -eq 0 ]] && is_darwin && ! meslo_nerd_font_installed; then
        need=1
    fi
    (( need == 1 )) || return 0

    printf '\nMeslo LGS Nerd Font missing for this user (iTerm / Vim glyphs).\n' >&2
    printf 'Install into your own Fonts folder (no sudo; preferred over brew cask):\n' >&2
    printf '  %s\n' "$helper" >&2
    if prompt_yn "Download and install Meslo Nerd Font now? [Y/n]"; then
        if "$helper" --yes; then
            if meslo_nerd_font_installed; then
                log "OK       meslo-nerd-font installed under ~/Library/Fonts"
            fi
        else
            echo "WARNING: install_meslo_nerd_font failed" >&2
        fi
    else
        echo "Skipped Meslo Nerd Font install." >&2
    fi
}

