# Look up the install hint recorded for a missing init_tool_* variable.
hint_for_missing_var()
{
    local want="$1"
    local entry name hint var

    for entry in "${REQUIRED_MISSING[@]+"${REQUIRED_MISSING[@]}"}" "${OPTIONAL_MISSING[@]+"${OPTIONAL_MISSING[@]}"}"; do
        [[ -n "$entry" ]] || continue
        name="${entry%%|*}"
        hint="${entry#*|}"
        var="init_tool_$(printf '%s' "$name" | tr '[:upper:]-' '[:lower:]_')"
        if [[ "$var" == "$want" ]]; then
            printf '%s' "$hint"
            return 0
        fi
    done
    return 1
}

