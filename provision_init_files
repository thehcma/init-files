admin_handoff_emitted=0

# Emit the MDM admin handoff at most once for this run. Args: brew specs.
# No-op for admins / non-modern-macOS / empty spec list.
ensure_brew_admin_handoff()
{
    local -a specs=("$@")

    # No-ops must return 0: this runs under set -e at the top level.
    is_modern_macos || return 0
    is_macos_admin && return 0
    ((${#specs[@]} > 0)) || return 0
    (( admin_handoff_emitted == 1 )) && return 0

    print_brew_admin_copy_paste "${specs[@]}"
    admin_handoff_emitted=1
    return 0
}

print_install_suggestions()
{
    local title="$1"
    shift
    local entry name hint
    local -a brew_entries=() other_entries=() brew_specs=()
    local spec

    (($# > 0)) || return 0

    # Auto-detect: non-admin on modern macOS gets brew packages only via the
    # forwardable handoff (not duplicated "install: brew …" lines).
    if is_modern_macos && ! is_macos_admin; then
        for entry in "$@"; do
            name="${entry%%|*}"
            hint="${entry#*|}"
            if [[ "$hint" == brew\ * ]]; then
                brew_entries+=("$entry")
                if spec="$(brew_spec_from_hint "$hint" 2>/dev/null)"; then
                    brew_specs+=("$spec")
                fi
            else
                other_entries+=("$entry")
            fi
        done

        if ((${#brew_specs[@]} > 0)); then
            ensure_brew_admin_handoff "${brew_specs[@]}"
        fi

        if ((${#other_entries[@]} > 0)); then
            printf '\n%s\n' "$title"
            for entry in "${other_entries[@]}"; do
                name="${entry%%|*}"
                hint="${entry#*|}"
                if [[ -n "$hint" ]]; then
                    printf '  %-14s  install: %s\n' "$name" "$hint"
                else
                    printf '  %-14s  (no install hint for this platform)\n' "$name"
                fi
            done
        elif ((${#brew_entries[@]} > 0)); then
            printf '\n%s\n' "$title"
            printf '  Homebrew packages: see ADMIN HANDOFF above (forward to IT), then re-run ./provision_init_files\n'
        fi
        return 0
    fi

    # Admin (or non-modern-macOS / Linux): direct install hints only — never an admin handoff.
    printf '\n%s\n' "$title"
    for entry in "$@"; do
        name="${entry%%|*}"
        hint="${entry#*|}"
        if [[ -n "$hint" ]]; then
            printf '  %-14s  install: %s\n' "$name" "$hint"
        else
            printf '  %-14s  (no install hint for this platform)\n' "$name"
        fi
    done
}

