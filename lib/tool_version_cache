# Shared tool-version cache helpers (lock + atomic write).
# shellcheck shell=bash
# Sourced by bashrc; also used by tests/tool-version-cache.test.
# See GitHub issue #26.

# Write stdin to dest via temp file + mv (same-filesystem atomic replace).
init_files_atomic_write()
{
    local dest="$1"
    local dir tmp

    [[ -n "$dest" && "$dest" == /* ]] || return 1
    dir=$(dirname -- "$dest")
    mkdir -p "$dir" 2>/dev/null || true
    tmp="${dest}.tmp.$$"
    cat > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    mv -f "$tmp" "$dest"
}

# mkdir-based lock. Args: lock_dir [stale_seconds=900]
# Writes lock_dir/pid. Removes stale locks (dead PID or aged directory).
# Returns 0 if acquired, 1 if held by a live owner.
init_files_mkdir_lock()
{
    local lock_dir="$1"
    local stale_seconds="${2:-900}"
    local tries=0 old_pid mtime now parent

    [[ -n "$lock_dir" && "$lock_dir" == /* ]] || return 1
    parent=$(dirname -- "$lock_dir")
    mkdir -p "$parent" 2>/dev/null || true

    while (( tries < 2 )); do
        if mkdir "$lock_dir" 2>/dev/null; then
            printf '%s\n' "$$" > "${lock_dir}/pid" 2>/dev/null || true
            return 0
        fi

        if [[ -f "${lock_dir}/pid" ]]; then
            old_pid=$(tr -d '[:space:]' < "${lock_dir}/pid" 2>/dev/null || true)
            if [[ "$old_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$old_pid" 2>/dev/null; then
                rm -rf "$lock_dir"
                tries=$((tries + 1))
                continue
            fi
        fi

        now=$(date +%s 2>/dev/null || echo 0)
        # Prefer GNU -c (Linux + modern-macOS gnubin); fall back to BSD -f.
        mtime=$(stat -c %Y "$lock_dir" 2>/dev/null || stat -f %m "$lock_dir" 2>/dev/null || echo 0)
        if [[ "$now" =~ ^[0-9]+$ && "$mtime" =~ ^[0-9]+$ ]] \
            && (( now > mtime && (now - mtime) >= stale_seconds )); then
            rm -rf "$lock_dir"
            tries=$((tries + 1))
            continue
        fi
        return 1
    done
    return 1
}

init_files_mkdir_unlock()
{
    local lock_dir="$1"

    [[ -n "$lock_dir" && "$lock_dir" == /* ]] || return 0
    rm -rf "$lock_dir" 2>/dev/null || true
}
