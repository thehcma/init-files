# ---------------------------------------------------------------------------
# Private config overlay freshness (URL drift + origin/main moved)
# ---------------------------------------------------------------------------

# Resolve $3 only when it names a commit. Unlike plain rev-parse, this prints
# nothing for an unborn symbolic HEAD.
init_files_git_resolve_commit()
{
    local git_bin="${1:-}" dir="${2:-}" revision="${3:-}"

    [[ -n "$git_bin" && -x "$git_bin" && -d "$dir" && -n "$revision" ]] || return 1
    "$git_bin" -C "$dir" rev-parse --verify "${revision}^{commit}" 2>/dev/null
}

# True when the worktree equals $3, allowing ignored host-local files. Uses a
# temporary index so an unborn clone's real index and files remain untouched.
init_files_git_worktree_matches_commit()
{
    local git_bin="${1:-}" dir="${2:-}" commit="${3:-}"
    local index_file extras rc=0

    [[ -n "$git_bin" && -x "$git_bin" && -d "$dir" && -n "$commit" ]] || return 1
    index_file="$(mktemp "${TMPDIR:-/tmp}/init-files-config-index.XXXXXX")" || return 1
    rm -f "$index_file" || return 1

    GIT_INDEX_FILE="$index_file" "$git_bin" -C "$dir" read-tree "$commit" 2>/dev/null || rc=$?
    if [[ $rc -eq 0 ]]; then
        GIT_INDEX_FILE="$index_file" "$git_bin" -C "$dir" diff --quiet --no-ext-diff \
            || rc=$?
    fi
    if [[ $rc -eq 0 ]]; then
        extras="$(GIT_INDEX_FILE="$index_file" "$git_bin" -C "$dir" \
            ls-files --others --exclude-standard 2>/dev/null || true)"
        [[ -z "$extras" ]] || rc=1
    fi
    rm -f "$index_file"
    return "$rc"
}

# Normalize a git remote for equality checks (HTTPS ↔ SSH for github.com).
init_files_normalize_git_repo_url()
{
    local u="${1:-}"

    u="${u#"${u%%[![:space:]]*}"}"
    u="${u%"${u##*[![:space:]]}"}"
    u="${u%/}"
    u="${u%.git}"
    if [[ "$u" =~ ^git@([^:]+):(.+)$ ]]; then
        printf 'https://%s/%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        return 0
    fi
    if [[ "$u" =~ ^ssh://([^@/]+@)?([^/]+)/(.+)$ ]]; then
        printf 'https://%s/%s\n' "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
        return 0
    fi
    printf '%s\n' "$u"
}

# origin URL for the private config clone (empty / fail if not a git clone).
init_files_private_config_origin_url()
{
    local dir git_bin

    dir="$(init_files_private_config_dir)"
    [[ -d "$dir/.git" ]] || return 1
    git_bin="$(command -v git 2>/dev/null || true)"
    [[ -n "$git_bin" && -x "$git_bin" ]] || return 1
    "$git_bin" -C "$dir" remote get-url origin 2>/dev/null
}

# True when preferred URL (env/pref) differs from clone origin (both set).
init_files_private_config_url_drifted()
{
    local preferred origin np no

    preferred="$(init_files_config_repo_url 2>/dev/null || true)"
    origin="$(init_files_private_config_origin_url 2>/dev/null || true)"
    [[ -n "$preferred" && -n "$origin" ]] || return 1
    np="$(init_files_normalize_git_repo_url "$preferred")"
    no="$(init_files_normalize_git_repo_url "$origin")"
    [[ -n "$np" && -n "$no" && "$np" != "$no" ]]
}

# True when local HEAD differs from cached origin/main (no network).
init_files_private_config_behind_cached()
{
    local dir git_bin head remote

    dir="$(init_files_private_config_dir)"
    [[ -d "$dir/.git" ]] || return 1
    git_bin="$(command -v git 2>/dev/null || true)"
    [[ -n "$git_bin" && -x "$git_bin" ]] || return 1
    head="$(init_files_git_resolve_commit "$git_bin" "$dir" HEAD 2>/dev/null || true)"
    remote="$(init_files_git_resolve_commit "$git_bin" "$dir" origin/main 2>/dev/null || true)"
    [[ -n "$remote" && "$head" != "$remote" ]]
}

# Fast-forward pull private config overlay. Returns 0 on success.
init_files_pull_private_config()
{
    local dir git_bin

    dir="$(init_files_private_config_dir)"
    git_bin="$(command -v git 2>/dev/null || true)"
    [[ -d "$dir/.git" && -n "$git_bin" && -x "$git_bin" ]] || return 1
    "$git_bin" -C "$dir" pull --ff-only
}
