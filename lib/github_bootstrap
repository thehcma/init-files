#!/usr/bin/env bash
# Guided GitHub bootstrap helpers for bootstrap_host (issue #18 UX).
# shellcheck shell=bash
# Sourced by bootstrap_host; expects log/die/prompt_yn/prompt_line/is_modern_macos
# is_macos_admin_user/openssh_client_install_hint from the caller. Not executed standalone.

# True when the current user is in a typical sudo-capable group.
bootstrap_user_in_sudo_group()
{
    local groups
    groups="$(id -nG 2>/dev/null || true)"
    [[ -n "$groups" ]] || return 1
    [[ " $groups " == *" sudo "* || " $groups " == *" wheel "* || " $groups " == *" admin "* ]]
}

bootstrap_can_sudo_nopasswd()
{
    [[ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]] && return 0
    command -v sudo >/dev/null 2>&1 || return 1
    sudo -n true >/dev/null 2>&1
}

# Linux: root, NOPASSWD, or sudo/wheel/admin group (interactive password OK).
bootstrap_linux_can_sudo_upgrade()
{
    [[ "${OSTYPE:-}" == darwin* ]] && return 0
    bootstrap_can_sudo_nopasswd && return 0
    bootstrap_user_in_sudo_group && return 0
    return 1
}

# Print OS tier + privilege context before guided steps (issue #18 UX).
bootstrap_platform_banner()
{
    local id ver sudo_note

    if [[ "${OSTYPE:-}" == darwin* ]]; then
        if is_modern_macos; then
            if is_macos_admin_user; then
                sudo_note="admin — Homebrew gh OK"
            else
                sudo_note="non-admin — gh installs to ~/.local; brew needs admin handoff"
            fi
            log "Platform: modern macOS (${sudo_note})"
        else
            log "Platform: older macOS — gh → ~/.local (no brew recommendations)"
        fi
        return 0
    fi

    id="linux"
    ver=
    if [[ -f /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        id="${ID:-linux}"
        ver="${VERSION_ID:-}"
    fi
    if bootstrap_linux_can_sudo_upgrade; then
        sudo_note="sudo-capable — distro packages via apt/dnf/yum when needed"
    else
        sudo_note="non-sudo — user-local gh OK; forward package installs to an admin"
    fi
    log "Platform: ${id}${ver:+ ${ver}} (${sudo_note})"
}

# Guided OpenSSH client install/check (SSH path). Uses openssh_client_install_hint from caller.
bootstrap_guided_install_openssh()
{
    local hint

    command -v ssh >/dev/null 2>&1 \
        && command -v ssh-add >/dev/null 2>&1 \
        && command -v scp >/dev/null 2>&1 \
        && return 0

    bootstrap_platform_banner
    hint="$(openssh_client_install_hint 2>/dev/null || true)"
    [[ -n "$hint" ]] || hint="install openssh-client (ssh, ssh-add, ssh-agent, scp)"

    if [[ "${OSTYPE:-}" == darwin* ]]; then
        cat >&2 <<EOF

OpenSSH client tools are missing (ssh, ssh-add, scp).
On macOS install Xcode Command Line Tools, then retry:

  xcode-select --install

EOF
        prompt_yn "Retry OpenSSH check after installing CLT? [Y/n]" || die "OpenSSH client required"
        bootstrap_guided_install_openssh
        return 0
    fi

    if bootstrap_linux_can_sudo_upgrade; then
        bootstrap_step_run \
            "install OpenSSH client (${hint})" \
            "$hint" \
            'command -v ssh >/dev/null 2>&1 && command -v ssh-add >/dev/null 2>&1 && command -v scp >/dev/null 2>&1' \
            || die "OpenSSH client install failed"
        return 0
    fi

    cat >&2 <<EOF

OpenSSH client tools are missing and this account cannot use sudo.
Forward to an admin, then retry:

  ${hint}

EOF
    prompt_yn "Retry OpenSSH check after admin installs packages? [Y/n]" \
        || die "OpenSSH client required for GitHub SSH"
    bootstrap_guided_install_openssh
}

# Run a bootstrap step with Y/n confirmation; on failure offer retry loop.
# Usage: bootstrap_step_run "description" command [verify_command]
# Both command and verify_command are eval'd in caller's shell.
bootstrap_step_run()
{
    local desc="$1"
    local run_cmd="$2"
    local verify_cmd="${3:-}"

    while true; do
        if ! prompt_yn "Step: ${desc} — proceed? [Y/n]"; then
            log "Skipped  ${desc}"
            return 1
        fi
        log "Running  ${desc}…"
        if eval "$run_cmd"; then
            if [[ -n "$verify_cmd" ]]; then
                if eval "$verify_cmd"; then
                    log "OK       ${desc}"
                    return 0
                fi
                log "WARN     ${desc}: verification failed"
            else
                log "OK       ${desc}"
                return 0
            fi
        else
            log "WARN     ${desc}: command failed"
        fi
        prompt_yn "Retry ${desc}? [Y/n]" || return 1
    done
}

bootstrap_verify_gh_cli()
{
    local gh_bin
    gh_bin="$(command -v gh 2>/dev/null || true)"
    [[ -n "$gh_bin" && -x "$gh_bin" ]] || return 1
    "$gh_bin" --version >/dev/null 2>&1
}

bootstrap_verify_gh_auth()
{
    local gh_bin
    gh_bin="$(command -v gh 2>/dev/null || true)"
    [[ -n "$gh_bin" && -x "$gh_bin" ]] || return 1
    "$gh_bin" auth status >/dev/null 2>&1
}

bootstrap_verify_node_toolchain()
{
    local candidate npm_bin
    local nvm_dir="${NVM_DIR:-$HOME/.nvm}"

    # install_node_toolchain runs as a child, so its nvm PATH cannot update us.
    for candidate in "$nvm_dir"/versions/node/*/bin/npm; do
        [[ -x "$candidate" ]] || continue
        if PATH="$(dirname "$candidate"):$PATH" "$candidate" --version >/dev/null 2>&1; then
            return 0
        fi
    done

    npm_bin="$(command -v npm 2>/dev/null || true)"
    [[ -n "$npm_bin" && -x "$npm_bin" ]] || return 1
    "$npm_bin" --version >/dev/null 2>&1
}

# Install gh from GitHub releases under ~/.local (Linux / older macOS bootstrap).
bootstrap_install_gh_release()
{
    local arch os_slug version tmp_dir archive extracted install_dir gh_bin
    local py curl_bin tar_bin

    curl_bin="$(command -v curl 2>/dev/null || true)"
    [[ -n "$curl_bin" && -x "$curl_bin" ]] || die "curl is required to download gh"

    case "$(uname -m)" in
        x86_64) arch="amd64" ;;
        aarch64|arm64) arch="arm64" ;;
        *) die "unsupported architecture for gh install: $(uname -m)" ;;
    esac

    if [[ "${OSTYPE:-}" == darwin* ]]; then
        os_slug="macOS"
        command -v unzip >/dev/null 2>&1 || die "unzip is required to install gh on macOS"
    else
        os_slug="linux"
        tar_bin="$(command -v tar 2>/dev/null || true)"
        [[ -n "$tar_bin" && -x "$tar_bin" ]] || die "tar is required to install gh"
    fi

    py="$(command -v python3 2>/dev/null || true)"
    if [[ -n "$py" && -x "$py" ]]; then
        version="$("$py" - <<'PY'
import json, urllib.request
with urllib.request.urlopen("https://api.github.com/repos/cli/cli/releases/latest", timeout=15) as r:
    print(json.load(r)["tag_name"].lstrip("v"))
PY
        )" || version=
    fi
    if [[ -z "$version" ]]; then
        version="$("$curl_bin" --silent --show-error --fail --location --max-time 15 \
            https://api.github.com/repos/cli/cli/releases/latest \
            | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\?\([^"]*\)".*/\1/p' \
            | head -1)"
    fi
    [[ -n "$version" ]] || die "could not resolve latest gh release version"

    tmp_dir="$(mktemp -d)" || die "mktemp failed"
    if [[ "$os_slug" == macOS ]]; then
        archive="${tmp_dir}/gh.zip"
        "$curl_bin" --silent --show-error --fail --location --max-time 120 \
            -o "$archive" \
            "https://github.com/cli/cli/releases/download/v${version}/gh_${version}_macOS_${arch}.zip" \
            || die "gh download failed"
        unzip -q "$archive" -d "$tmp_dir" || die "gh unzip failed"
        extracted="$(find "$tmp_dir" -type f -name gh -perm -111 2>/dev/null | head -1)"
    else
        archive="${tmp_dir}/gh.tar.gz"
        "$curl_bin" --silent --show-error --fail --location --max-time 120 \
            -o "$archive" \
            "https://github.com/cli/cli/releases/download/v${version}/gh_${version}_linux_${arch}.tar.gz" \
            || die "gh download failed"
        "$tar_bin" -xzf "$archive" -C "$tmp_dir" || die "gh extract failed"
        extracted="$(find "$tmp_dir" -type f -path '*/bin/gh' 2>/dev/null | head -1)"
    fi
    [[ -n "$extracted" && -x "$extracted" ]] || die "gh binary not found in archive"

    install_dir="${HOME}/.local/opt/gh-${version}"
    mkdir -p "$install_dir" "$HOME/.local/bin" || die "cannot create ~/.local"
    rm -rf "$install_dir"
    mkdir -p "$install_dir"
    cp "$extracted" "${install_dir}/gh" || die "cannot install gh binary"
    chmod 755 "${install_dir}/gh"
    ln -sf "${install_dir}/gh" "${HOME}/.local/bin/gh"
    rm -rf "$tmp_dir"
    export PATH="${HOME}/.local/bin:${PATH}"
    hash -r
    gh_bin="$(command -v gh 2>/dev/null || true)"
    [[ -n "$gh_bin" && -x "$gh_bin" ]] || die "gh installed but not on PATH"
    log "Installed gh ${version} -> ${gh_bin/#$HOME/~}"
}

# Offer user-local Node (nvm) when clone exists or via raw install script URL.
bootstrap_offer_node_toolchain()
{
    local node_script clone_dir="${1:-}"

    [[ ${quiet:-0} -eq 1 ]] || [[ ! -t 0 || ! -t 2 ]] && return 0
    if ! prompt_yn "Install user-local Node (nvm + LTS) for npm/gt/gh extensions? [Y/n]"; then
        return 0
    fi
    if [[ -n "$clone_dir" && -x "${clone_dir}/install_node_toolchain" ]]; then
        bootstrap_step_run \
            "install Node toolchain (nvm + LTS)" \
            "\"${clone_dir}/install_node_toolchain\"" \
            bootstrap_verify_node_toolchain \
            || log "WARN     Node install skipped or failed (optional)"
        return 0
    fi
    node_script="${INIT_FILES_RAW_BASE:-https://raw.githubusercontent.com/thehcma/init-files/main}/install_node_toolchain"
    bootstrap_step_run \
        "install Node toolchain from ${node_script}" \
        "curl -fsSL \"${node_script}\" -o /tmp/install_node_toolchain && chmod +x /tmp/install_node_toolchain && /tmp/install_node_toolchain -y" \
        bootstrap_verify_node_toolchain \
        || log "WARN     Node install skipped or failed (optional)"
}

# Guided HTTPS path: gh install → verify → auth → verify.
bootstrap_guided_github_https()
{
    local gh_bin brew_bin user

    bootstrap_platform_banner

    cat >&2 <<EOF

GitHub HTTPS setup (recommended)
  • Installs GitHub CLI (gh) when missing
  • Runs gh auth login (HTTPS git credentials)
  • Optionally installs user-local Node (nvm) for npm/gt

EOF

    if bootstrap_verify_gh_cli; then
        log "OK       gh already installed: $(gh --version 2>/dev/null | head -1)"
    else
        if is_modern_macos; then
            brew_bin="$(command -v brew 2>/dev/null || true)"
            if [[ -z "$brew_bin" ]]; then
                for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew "${HOME}/homebrew/bin/brew"; do
                    [[ -x "$brew_bin" ]] && break
                    brew_bin=""
                done
            fi
            if [[ -n "$brew_bin" && -x "$brew_bin" ]] && is_macos_admin_user; then
                bootstrap_step_run \
                    "install gh (Homebrew)" \
                    "\"$brew_bin\" install gh && eval \"\$($brew_bin shellenv 2>/dev/null)\" && export PATH" \
                    bootstrap_verify_gh_cli \
                    || die "gh install failed"
            elif [[ -n "$brew_bin" && -x "$brew_bin" ]]; then
                user="$(id -un 2>/dev/null || echo unknown)"
                cat >&2 <<EOF

This account (${user}) is not a macOS administrator.
Forward to an admin, then retry this step:

  brew install gh

EOF
                prompt_yn "Try installing gh from GitHub release to ~/.local instead? [Y/n]" \
                    || die "gh required for HTTPS bootstrap"
                bootstrap_step_run \
                    "install gh (GitHub release → ~/.local)" \
                    bootstrap_install_gh_release \
                    bootstrap_verify_gh_cli \
                    || die "gh install failed"
            else
                bootstrap_step_run \
                    "install gh (GitHub release → ~/.local)" \
                    bootstrap_install_gh_release \
                    bootstrap_verify_gh_cli \
                    || die "gh install failed"
            fi
        else
            bootstrap_platform_banner
            log "Installing gh to ~/.local (no sudo required on Linux)"
            bootstrap_step_run \
                "install gh (GitHub release → ~/.local)" \
                bootstrap_install_gh_release \
                bootstrap_verify_gh_cli \
                || die "gh install failed"
        fi
    fi

    gh_bin="$(command -v gh 2>/dev/null || true)"
    [[ -n "$gh_bin" && -x "$gh_bin" ]] || die "gh not on PATH after install"

    if bootstrap_verify_gh_auth; then
        log "OK       gh already authenticated"
    else
        bootstrap_step_run \
            "gh auth login (HTTPS)" \
            "\"$gh_bin\" auth login" \
            bootstrap_verify_gh_auth \
            || die "gh auth login failed or was not completed"
    fi

    log "OK       GitHub HTTPS ready ($( "$gh_bin" auth status 2>&1 | head -1 || true ))"
}
