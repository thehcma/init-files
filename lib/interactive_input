#!/usr/bin/env bash
# Input checks for interactive bashrc helpers (bt, cache_ssh).
# shellcheck shell=bash
# Sourced only — do not execute.
#
# Trust model: the operator already has a shell as this user. These helpers
# catch foot-guns (missing binaries, loose key modes, bad timeouts), not a
# multi-tenant sanitizer.

# True when $1 is an existing regular executable file (not a directory).
init_files_bt_program_ok()
{
    local prog="${1-}"

    [[ -n "$prog" ]] || return 1
    [[ -f "$prog" && -x "$prog" ]] || return 1
    return 0
}

# True when $1 looks like an ssh-add -t duration (e.g. 3600, 4h, 30m, 1d).
init_files_ssh_timeout_ok()
{
    local t="${1-}"

    [[ -n "$t" ]] || return 1
    [[ "$t" =~ ^[0-9]+[smhd]?$ ]] || return 1
    return 0
}

# True when $1 is a usable private key path for cache_ssh:
# regular file; absolute or under $HOME/.ssh; not world-readable/writable.
init_files_ssh_key_usable()
{
    local key="${1-}"
    local mode home_ssh resolved

    [[ -n "$key" && "$key" != "." && "$key" != ".." ]] || return 1
    [[ -f "$key" ]] || return 1

    home_ssh="${HOME}/.ssh"
    case "$key" in
        /*)
            ;;
        *)
            # Relative paths only if they resolve under ~/.ssh.
            if [[ -d "$home_ssh" ]]; then
                resolved="$(cd "$(dirname -- "$key")" 2>/dev/null && pwd)/$(basename -- "$key")"
                case "$resolved" in
                    "${home_ssh}"/*) ;;
                    *) return 1 ;;
                esac
            else
                return 1
            fi
            ;;
    esac

    # Reject group/other read or write (typical private-key modes are 600/400).
    if stat --version > /dev/null 2>&1; then
        mode="$(stat -c '%a' -- "$key" 2>/dev/null || true)"
    else
        mode="$(stat -f '%OLp' -- "$key" 2>/dev/null || true)"
    fi
    [[ -n "$mode" ]] || return 1
    # Last three octal digits (handles 600 or 100600).
    if ((${#mode} > 3)); then
        mode="${mode:$((${#mode} - 3))}"
    fi
    [[ "$mode" =~ ^[0-7]{3}$ ]] || return 1
    local o g
    o=$((8#${mode:2:1}))
    g=$((8#${mode:1:1}))
    (( o == 0 )) || return 1
    (( g == 0 )) || return 1
    return 0
}

# Print every existing IdentityFile from OpenSSH's effective config for $2,
# in config order (deduplicated).
# Usage: init_files_ssh_keys_for_host ssh_binary user@host
init_files_ssh_keys_for_host()
{
    local ssh_cmd="${1-}" host="${2-}"
    local option key seen="" found=1

    init_files_bt_program_ok "$ssh_cmd" || return 1
    [[ -n "$host" ]] || return 1

    while read -r option key; do
        [[ "$option" == identityfile && -n "$key" && "$key" != none ]] || continue
        key="${key/#\~/$HOME}"
        key="${key//\%d/$HOME}"
        [[ -f "$key" ]] || continue
        case "$seen" in *"|${key}|"*) continue ;; esac
        seen+="|${key}|"
        printf '%s\n' "$key"
        found=0
    done < <("$ssh_cmd" -G -- "$host" 2>/dev/null)
    return "$found"
}

# Print the first existing IdentityFile from OpenSSH's effective config for $2.
# Usage: init_files_ssh_key_for_host ssh_binary user@host
init_files_ssh_key_for_host()
{
    local first=""
    IFS= read -r first < <(init_files_ssh_keys_for_host "$@" 2>/dev/null) || true
    [[ -n "$first" ]] || return 1
    printf '%s\n' "$first"
}

# Ensure a key usable for this host is loaded in ssh-agent. The cache is keyed
# by credential (key fingerprint), not host: if ANY of the host's candidate
# IdentityFiles is already loaded, hosts sharing that key never re-prompt.
# Only when none is loaded do we prompt, for the first candidate.
# SSH_CACHE_KEY remains an explicit global override.
init_files_cache_ssh_for_host()
{
    local host="${1-}" ssh_cmd k
    local -a keys=()

    if [[ -z "${SSH_CACHE_KEY:-}" && -n "$host" ]]; then
        ssh_cmd="${init_tool_ssh:-}"
        if ! init_files_bt_program_ok "$ssh_cmd"; then
            ssh_cmd="$(command -v ssh 2>/dev/null || true)"
        fi
        while IFS= read -r k; do
            [[ -n "$k" ]] && keys+=("$k")
        done < <(init_files_ssh_keys_for_host "$ssh_cmd" "$host" 2>/dev/null || true)
    fi

    # ssh -G appends OpenSSH's default identities after configured ones. When
    # the host names explicit keys, only those count: an unrelated default key
    # already in the agent must not satisfy the check. Limitation: ssh -G does
    # not mark which entries were configured, so a host that pins a default-
    # named key (id_ed25519, ...) is treated like the defaults (any loaded wins).
    local -a explicit=()
    for k in "${keys[@]+"${keys[@]}"}"; do
        case "${k##*/}" in
            id_rsa|id_dsa|id_ecdsa|id_ecdsa_sk|id_ed25519|id_ed25519_sk|id_xmss) ;;
            *) explicit+=("$k") ;;
        esac
    done
    if ((${#explicit[@]} > 0)); then
        keys=("${explicit[@]}")
    fi

    if ((${#keys[@]} > 0)); then
        for k in "${keys[@]}"; do
            cache_ssh -c "$k" 2>/dev/null && return 0
        done
        cache_ssh "${keys[0]}"
        return $?
    fi
    cache_ssh -c 2>/dev/null || cache_ssh
}
