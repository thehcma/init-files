#!/usr/bin/env bash
# Bounded dedupe/rotate helpers for bash history archives (issue #9).
# shellcheck shell=bash
# Sourced by bashrc; used by tests/history-rotate.test.
# Prefer recorded init_tool_python3 via init_files_verify_tool_path (lib/tool_path);
# fall back to /usr/bin/python3 or PATH python3. Lock/atomic helpers live in bashrc
# (lib/tool_version_cache) around rotate_bash_history, not in this file.

# Soft thresholds: schedule background rotate when exceeded.
INIT_FILES_HISTORY_SOFT_BYTES=$((16 * 1024 * 1024))
INIT_FILES_HISTORY_SOFT_LINES=100000
# Hard caps after rewrite (whichever binds first).
INIT_FILES_HISTORY_HARD_UNIQUES=50000
INIT_FILES_HISTORY_HARD_BYTES=$((8 * 1024 * 1024))
# Session HISTFILE cleanup.
INIT_FILES_HISTORY_SESSION_MAX_AGE_DAYS=14
INIT_FILES_HISTORY_SESSION_MAX_COUNT=100

_init_files_history_python()
{
    if [[ -n "${init_tool_python3:-}" ]] \
        && declare -F init_files_verify_tool_path > /dev/null 2>&1 \
        && init_files_verify_tool_path "$init_tool_python3"
    then
        printf '%s\n' "$init_tool_python3"
        return 0
    fi
    if [[ -x /usr/bin/python3 ]]; then
        printf '%s\n' /usr/bin/python3
        return 0
    fi
    command -v python3 2>/dev/null || return 1
}

# True when path exceeds soft size or line thresholds (missing file → false).
init_files_history_soft_oversize()
{
    local path="$1"
    local size lines

    [[ -n "$path" && -f "$path" ]] || return 1
    size=$(wc -c < "$path" 2>/dev/null || echo 0)
    [[ "$size" =~ ^[0-9]+$ ]] || return 1
    if (( size > INIT_FILES_HISTORY_SOFT_BYTES )); then
        return 0
    fi
    lines=$(wc -l < "$path" 2>/dev/null || echo 0)
    [[ "$lines" =~ ^[0-9]+$ ]] || return 1
    (( lines > INIT_FILES_HISTORY_SOFT_LINES ))
}

# Rewrite src → dest: last-occurrence dedupe of commands, keep paired #timestamps,
# then keep a suffix that fits hard unique/byte caps. Returns 0 on success.
init_files_history_rewrite_bounded()
{
    local src="$1"
    local dest="$2"
    local py

    [[ -n "$src" && -f "$src" && -n "$dest" ]] || return 1
    py="$(_init_files_history_python)" || return 1

    "$py" - "$src" "$dest" \
        "$INIT_FILES_HISTORY_HARD_UNIQUES" "$INIT_FILES_HISTORY_HARD_BYTES" <<'PY'
import re
import sys

src, dest, hard_uniques_s, hard_bytes_s = sys.argv[1:5]
hard_uniques = int(hard_uniques_s)
hard_bytes = int(hard_bytes_s)

# Bash HISTTIMEFORMAT lines are exactly "#<epoch>" (optional CR before NL).
_ts_re = re.compile(r"^#[0-9]+\r?\n?\Z")

# Corruption left by an older bashrc that tail-copied history mid-line into
# history.all (offset stored as an archive-file size — see docs/shell-ux.md):
#   - a word glued to a 9-10 digit epoch:  "make insta1782398107"
#   - a bare epoch that lost its "#":       "1782398107"
#   - orphan block / heredoc terminators:   "EOF", "done", "fi", "}", ")"
# A letter immediately followed (no space/punctuation) by a 4+ digit run at end
# of line is a command tail glued to a spliced-in timestamp/counter: "make
# ins9812641", "cache_s38094", "git p0938355". A real command separates a
# trailing number with a space or punctuation, so requiring the letter to touch
# the digits keeps legit "sleep 3600" / "kill 12345" / "curl host:8080".
_mashed_epoch_re = re.compile(r"[A-Za-z]\d{4,}\s*\Z")
_bare_epoch_re = re.compile(r"^\s*1?[78]\d{8}\s*\Z")
# A "#<4+ digits>" touching a non-space char is a HISTTIMEFORMAT stamp spliced
# into the middle of a command line: "#17797git pull", "kill g#1784409918".
_epoch_splice_re = re.compile(r"#\d{4,}\S|\S#\d{4,}")
# Control chars (not \t \n \r) never belong in a history line.
_ctrl_re = re.compile(r"[\x00-\x08\x0e-\x1f]")
# 15+ of the same character in a row: a held key / botched paste ("AAAAA…").
_runaway_re = re.compile(r"(.)\1{14,}")
_orphan_terms = {
    "EOF", "'EOF'", '"EOF"', "done", "fi", "esac", "then", "else", "elif",
    "do", "}", "{", ")", "(", ";;", ");;",
}


def is_corrupt(cmd):
    stripped = cmd.strip()
    if not stripped:
        return True
    if stripped in _orphan_terms:
        return True
    if _ctrl_re.search(cmd):
        return True
    if _runaway_re.search(cmd):
        return True
    if _epoch_splice_re.search(cmd):
        return True
    if _bare_epoch_re.match(cmd):
        return True
    if _mashed_epoch_re.search(cmd):
        return True
    return False


# entries: list of (optional_ts_line_or_None, command_line)
entries = []
pending_ts = None
with open(src, "r", encoding="utf-8", errors="replace") as f:
    for line in f:
        if _ts_re.match(line):
            pending_ts = line
            continue
        line = line.replace("\r\n", "\n").replace("\r", "\n")
        if is_corrupt(line):
            pending_ts = None
            continue
        entries.append((pending_ts, line))
        pending_ts = None

# Last occurrence wins: walk reverse, keep first time we see each command text.
seen = set()
kept_rev = []
for ts, cmd in reversed(entries):
    key = cmd
    if key in seen:
        continue
    seen.add(key)
    kept_rev.append((ts, cmd))

kept = list(reversed(kept_rev))

# Cap by unique count from the end (most recent).
if len(kept) > hard_uniques:
    kept = kept[-hard_uniques:]

# Cap by byte size from the end.
def entry_bytes(pair):
    ts, cmd = pair
    n = len(cmd.encode("utf-8", errors="replace"))
    if ts is not None:
        n += len(ts.encode("utf-8", errors="replace"))
    return n

total = sum(entry_bytes(p) for p in kept)
while kept and total > hard_bytes:
    total -= entry_bytes(kept[0])
    kept.pop(0)

with open(dest, "w", encoding="utf-8", errors="replace") as out:
    for ts, cmd in kept:
        if ts is not None:
            out.write(ts)
        out.write(cmd)
PY
}

# Merge history sources into one #ts/command stream on stdout->dest, in ascending
# trust order (least trusted first) so a later last-occurrence-wins dedupe in
# init_files_history_rewrite_bounded keeps the most trusted / most recent copy:
#
#   1. history.all commands seen >= freq_min times   (repeated == probably real;
#      recovers good history on machines whose archive is not yet deduped, and
#      contributes ~nothing once it has been)
#   2. ~/.bash_history                               (written by history -a; only
#      lightly damaged)
#   3. per-session history.<host>.<pid>.<ts> files, oldest filename first
#      (pristine — history_bootstrap never reads these, so the mid-line splice
#      bug never touched them)
#
# No filtering here: init_files_history_rewrite_bounded does corruption/dedupe.
# Usage: init_files_history_merge_sources <hist_dir> <archive> <legacy> <dest> [freq_min]
init_files_history_merge_sources()
{
    local hist_dir="$1" archive="$2" legacy="$3" dest="$4"
    local freq_min="${5:-2}"
    local py

    [[ -n "$hist_dir" && -d "$hist_dir" && -n "$dest" ]] || return 1
    py="$(_init_files_history_python)" || return 1

    "$py" - "$hist_dir" "$archive" "$legacy" "$dest" "$freq_min" <<'PY'
import glob
import os
import re
import sys

hist_dir, archive, legacy, dest, freq_min_s = sys.argv[1:6]
freq_min = max(1, int(freq_min_s))

_ts_re = re.compile(r"^#[0-9]+\r?\n?\Z")


def read_pairs(path):
    """Yield (ts_line_or_None, command_line) from a bash history file."""
    if not path or not os.path.isfile(path):
        return
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        pending = None
        for line in fh:
            if _ts_re.match(line):
                pending = line
                continue
            yield (pending, line)
            pending = None


out = open(dest, "w", encoding="utf-8", errors="replace")


def emit(pairs):
    for ts, cmd in pairs:
        if ts is not None:
            out.write(ts)
        out.write(cmd)


# 1) archive commands that recur (frequency survives only pre-dedupe archives).
if archive and os.path.isfile(archive):
    counts = {}
    for _ts, cmd in read_pairs(archive):
        counts[cmd] = counts.get(cmd, 0) + 1
    emit((ts, cmd) for ts, cmd in read_pairs(archive) if counts.get(cmd, 0) >= freq_min)

# 2) legacy ~/.bash_history
emit(read_pairs(legacy))

# 3) per-session files, oldest filename (…<pid>.<YYYYmmddHHMMSS>) first
sessions = [
    p for p in glob.glob(os.path.join(hist_dir, "history.*"))
    if re.search(r"\.\d+\.\d{8,}$", os.path.basename(p))
]
sessions.sort(key=lambda p: p.rsplit(".", 1)[-1])
for s in sessions:
    emit(read_pairs(s))

out.close()
PY
}

# Prune per-session HISTFILEs under dir (history.<host>.<pid>.*), not history.all.
# Deletes files older than MAX_AGE_DAYS; if more than MAX_COUNT remain, drop oldest.
init_files_history_prune_sessions()
{
    local dir="$1"
    local max_age_days="${2:-$INIT_FILES_HISTORY_SESSION_MAX_AGE_DAYS}"
    local max_count="${3:-$INIT_FILES_HISTORY_SESSION_MAX_COUNT}"
    local f now mtime age_days
    local -a sessions=()

    [[ -n "$dir" && -d "$dir" ]] || return 0
    now=$(date +%s 2>/dev/null || echo 0)
    [[ "$now" =~ ^[0-9]+$ ]] || return 0

    shopt -s nullglob
    for f in "$dir"/history.*; do
        [[ -f "$f" ]] || continue
        case "$(basename -- "$f")" in
            history.all|history.all.*|last-rotate|rotate.log) continue ;;
            history.*) ;;
            *) continue ;;
        esac
        # Skip lock dirs / non-session names like history.all
        [[ "$(basename -- "$f")" == history.all ]] && continue
        sessions+=("$f")
    done
    shopt -u nullglob

    for f in "${sessions[@]+"${sessions[@]}"}"; do
        mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)
        [[ "$mtime" =~ ^[0-9]+$ ]] || continue
        age_days=$(( (now - mtime) / 86400 ))
        if (( age_days > max_age_days )); then
            rm -f -- "$f" 2>/dev/null || true
        fi
    done

    sessions=()
    shopt -s nullglob
    for f in "$dir"/history.*; do
        [[ -f "$f" ]] || continue
        [[ "$(basename -- "$f")" == history.all ]] && continue
        case "$(basename -- "$f")" in
            history.all*|last-rotate|rotate.log) continue ;;
            history.*) sessions+=("$f") ;;
        esac
    done
    shopt -u nullglob

    if ((${#sessions[@]} > max_count)); then
        # Oldest first via mtime sort.
        local sorted
        # shellcheck disable=SC2207
        sorted=($(
            for f in "${sessions[@]}"; do
                mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)
                printf '%s\t%s\n' "$mtime" "$f"
            done | sort -n | cut -f2-
        ))
        local excess=$((${#sorted[@]} - max_count))
        local i
        for (( i = 0; i < excess; i++ )); do
            rm -f -- "${sorted[i]}" 2>/dev/null || true
        done
    fi
    return 0
}
