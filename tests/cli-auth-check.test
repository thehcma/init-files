#!/usr/bin/env bash
# Tests for lib/cli_auth_check: periodic gh / coderabbit re-login warning.
# Token cases deliberately set GH_TOKEN inside subshells so nothing leaks between cases.
# shellcheck disable=SC2030,SC2031
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

root="$(cd "${script_dir}/.." && pwd)"
readonly root

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin" "$work/state"
export XDG_STATE_HOME="$work/state"
# Inherited tokens would change the stubs' behavior; token cases set their own.
unset GH_TOKEN GITHUB_TOKEN
export init_tool_gh="$work/bin/gh"
export init_files_host="testhost"

# make_stub <name> <exit-code>: stub CLI whose `auth status` exits with the code.
make_stub() {
  printf '#!/bin/sh\nexit %s\n' "$2" > "$work/bin/$1"
  chmod +x "$work/bin/$1"
}

# Run in a clean subshell so PATH / init_tool_* / state never leak.
run_problems() {
  (
    PATH="$work/bin:/usr/bin:/bin"
    init_files_coderabbit_cli() { [[ -x "$work/bin/coderabbit" ]] && printf '%s\n' "$work/bin/coderabbit"; }
    # shellcheck disable=SC1091
    source "$root/lib/cli_auth_check"
    init_files_cli_auth_problems
  )
}

run_check() {
  (
    PATH="$work/bin:/usr/bin:/bin"
    init_files_coderabbit_cli() { [[ -x "$work/bin/coderabbit" ]] && printf '%s\n' "$work/bin/coderabbit"; }
    # shellcheck disable=SC1091
    source "$root/lib/cli_auth_check"
    init_files_cli_auth_check "$@" 2>&1
  )
}

printf '\n=== problems ===\n'
make_stub gh 0
make_stub coderabbit 0
assert_eq 'both logged in: no output' "$(run_problems)" ''

make_stub gh 1
assert_contains 'gh failing is reported with fix' "$(run_problems)" 'gh|auth check failed for github.com|env -u GH_TOKEN -u GITHUB_TOKEN '
assert_not_contains 'coderabbit ok not reported' "$(run_problems)" 'coderabbit'

make_stub gh 0
make_stub coderabbit 1
assert_contains 'coderabbit failing is reported with fix' "$(run_problems)" 'coderabbit|auth check failed|'

rm -f "$work/bin/coderabbit"
assert_eq 'missing coderabbit skipped silently' "$(run_problems)" ''

# Fix text targets the probed binary: bare name when it is that binary on PATH,
# the resolved path otherwise (recorded path outside PATH, cr-only installs).
make_stub gh 1
make_stub coderabbit 1
assert_contains 'on-PATH coderabbit fix is the bare name' "$(run_problems)" '|coderabbit auth login'
run_problems_offpath() {
  (
    PATH="/usr/bin:/bin"
    init_files_coderabbit_cli() { printf '%s\n' "$work/bin/coderabbit"; }
    # shellcheck disable=SC1091
    source "$root/lib/cli_auth_check"
    init_files_cli_auth_problems
  )
}
assert_contains 'off-PATH coderabbit fix is the resolved path' "$(run_problems_offpath)" "|$work/bin/coderabbit auth login"
assert_contains 'off-PATH gh fix is the resolved path' "$(run_problems_offpath)" "$work/bin/gh auth login --hostname github.com"
make_stub coderabbit 0

# Exported token rejected while the stored login is fine -> gh-env (unset it).
# shellcheck disable=SC2016  # $GH_TOKEN must stay literal in the stub script
printf '#!/bin/sh\n[ -n "$GH_TOKEN$GITHUB_TOKEN" ] && exit 1\nexit 0\n' > "$work/bin/gh"
chmod +x "$work/bin/gh"
out="$(GH_TOKEN=expired run_problems)"
assert_contains 'bad env token -> gh-env' "$out" 'gh-env|exported GH_TOKEN/GITHUB_TOKEN is rejected'
assert_contains 'gh-env fix is unset' "$out" '|unset GH_TOKEN GITHUB_TOKEN'
assert_eq 'no env token and stored ok: silent' "$(run_problems)" ''
make_stub gh 1
assert_not_contains 'stored login bad stays gh' "$(GH_TOKEN=x run_problems)" 'gh-env'

printf '\n=== check (throttle) ===\n'
make_stub gh 1
out="$(run_check --force)"
assert_contains 'force prints header' "$out" 'CLI login needs attention'
assert_contains 'force prints command' "$out" 'gh auth login'
if [[ -f "$work/state/init-files/last-cli-auth-check.testhost" ]]; then pass_case 'stamp written'; else fail_case 'stamp written'; fi

# A different host's stamp must not throttle this one.
assert_contains 'stamp is host-scoped' "$(ls "$work/state/init-files")" "last-cli-auth-check.testhost"

# Non-interactive subshell without --force must stay silent.
assert_eq 'non-interactive silent' "$(run_check)" ''

make_stub gh 0
assert_eq 'healthy forced check is silent' "$(run_check --force)" ''

printf '\n=== offer login ===\n'
make_login_stub() {
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s/login.log"\nexit %s\n' "$work" "$2" > "$work/bin/$1"
  chmod +x "$work/bin/$1"
}
run_offer() { # <tool> <fix> <stdin-line>
  (
    PATH="$work/bin:/usr/bin:/bin"
    init_files_coderabbit_cli() { printf '%s\n' "$work/bin/coderabbit"; }
    # shellcheck disable=SC1091
    source "$root/lib/cli_auth_check"
    printf '%s\n' "$3" | init_files_cli_auth_offer_login "$1" "$2" 2>&1
  )
}
rm -f "$work/login.log"
make_login_stub gh 0
out="$(run_offer gh 'gh auth login' y)"
assert_contains 'yes runs gh login' "$(cat "$work/login.log")" 'auth login --hostname github.com'
assert_contains 'yes reports renewed' "$out" 'gh login renewed'

rm -f "$work/login.log"
out="$(run_offer gh 'gh auth login' n)"
if [[ ! -f "$work/login.log" ]]; then pass_case 'no skips login'; else fail_case 'no skips login'; fi
assert_contains 'no prints renew-later hint' "$out" 'Renew later: gh auth login'

rm -f "$work/login.log"
make_login_stub coderabbit 0
run_offer coderabbit 'coderabbit auth login' '' > /dev/null
assert_contains 'empty answer defaults to yes (coderabbit)' "$(cat "$work/login.log")" 'auth login'

make_login_stub gh 1
out="$(run_offer gh 'gh auth login' y)"
assert_contains 'failed login reports retry' "$out" 'did not complete; retry: gh auth login'

printf '\n=== dev hosts only ===\n'
# shellcheck disable=SC1091
source "$root/lib/cli_auth_check"
if init_files_cli_auth_check_enabled; then pass_case 'enabled when no-dev predicate absent'; else fail_case 'enabled when no-dev predicate absent'; fi
_init_files_is_no_dev_host() { return 0; }
if init_files_cli_auth_check_enabled; then fail_case 'disabled on no-dev host'; else pass_case 'disabled on no-dev host'; fi
_init_files_is_no_dev_host() { return 1; }
if init_files_cli_auth_check_enabled; then pass_case 'enabled on dev host'; else fail_case 'enabled on dev host'; fi
unset -f _init_files_is_no_dev_host

printf '\n=== gh-env renewal ===\n'
res="$(export GH_TOKEN=expired GITHUB_TOKEN=expired; init_files_cli_auth_login gh-env; printf '%s' "${GH_TOKEN:-}${GITHUB_TOKEN:-}")"
assert_eq 'gh-env unsets exported tokens' "$res" ''

printf '\n=== gh renewal with a still-rejected exported token ===\n'
# login succeeds, but status keeps failing while a token is exported.
cat > "$work/bin/gh" <<'STUB'
#!/bin/sh
case "$*" in
  *"auth login"*) exit 0 ;;
esac
[ -n "$GH_TOKEN$GITHUB_TOKEN" ] && exit 1
exit 0
STUB
chmod +x "$work/bin/gh"
out="$(export GH_TOKEN=expired; printf 'y\ny\n' | init_files_cli_auth_offer_login gh 'gh auth login' 2>&1)"
assert_contains 'still-rejected token is not called renewed' "$out" 'still overrides it and is rejected'
assert_contains 'unset offered then reported' "$out" 'renewed (exported token unset)'
out="$(export GH_TOKEN=expired; printf 'y\nn\n' | init_files_cli_auth_offer_login gh 'gh auth login' 2>&1)"
assert_contains 'declined unset keeps failing hint' "$out" 'unset GH_TOKEN GITHUB_TOKEN'
assert_not_contains 'declined unset is not success' "$out" 'login renewed.'
out="$(printf 'y\n' | init_files_cli_auth_offer_login gh 'gh auth login' 2>&1)"
assert_contains 'no token: plain renewed' "$out" 'gh login renewed.'

test_summary
