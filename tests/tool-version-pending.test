#!/usr/bin/env bash
# Tests for pending-updates sidecar / drift detection (issue #40).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

root="$(cd "${script_dir}/.." && pwd)"
readonly root
bashrc="${root}/bashrc"

printf '\n=== static: helpers + call sites ===\n'
text="$(<"$bashrc")"
assert_contains 'defines pending note helper' "$text" '_tool_version_note_pending()'
assert_contains 'defines live version probe' "$text" 'tool_live_installed_version()'
assert_contains 'defines drift check' "$text" 'tool_version_pending_drifted()'
assert_contains 'defines update_tools' "$text" 'function update_tools'
assert_contains 'defines update action classifier' "$text" '_tool_version_record_update_action()'
assert_contains 'defines update footer helper' "$text" '_tool_version_append_update_footer()'
assert_contains 'defines self-names for offer helper' "$text" '_tool_version_self_names_for_offer()'
assert_contains 'defines maybe-offer helper' "$text" '_tool_version_maybe_offer_update_tools()'
assert_contains 'defines finish-report helper' "$text" '_tool_version_finish_report_print()'
assert_contains 'defines cached report usable helper' "$text" '_tool_version_cached_report_usable()'
assert_contains 'defines after-wait report reuse helper' "$text" '_tool_version_report_reusable_after_wait()'
assert_contains 'uses rebuild lock' "$text" '/rebuild.lock'
assert_contains 'uses offer lock' "$text" 'update-offer.lock'
assert_contains 'offers batch upgrade prompt' "$text" 'Upgrade outdated tools now'
assert_contains 'writes pending-updates' "$text" 'pending-updates'
assert_contains 'writes pending-self-names' "$text" 'pending-self-names'
assert_contains 'stamps update-offer-done' "$text" 'update-offer-done'
assert_contains 'finish path offers on cache and rebuild' "$text" '_tool_version_finish_report_print'
# Needle is a literal bashrc snippet (includes "$pending_file").
# shellcheck disable=SC2016
assert_contains 'fast path checks drift' "$text" 'tool_version_pending_drifted "$pending_file"'
# GNU `stat -f` is --file-system and prints to stdout on failure; BSD-first breaks Linux.
# Needles are literal bashrc snippets (include "$cache_file" / "$report_file").
# shellcheck disable=SC2016
assert_contains 'prefers GNU stat -c for cache mtime' "$text" \
    'cache_mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)'
# shellcheck disable=SC2016
assert_contains 'prefers GNU stat -c for report mtime' "$text" \
    'report_mtime=$(stat -c %Y "$report_file" 2>/dev/null || stat -f %m "$report_file" 2>/dev/null || echo 0)'
assert_contains 'batch footer mentions update_tools' "$text" 'upgrade all (this account): update_tools'
# add_tool_update_notice / tool_status_line must not emit per-tool suggested commands.
if sed -n '/^function add_tool_update_notice()$/,/^}$/p' "$bashrc" | grep -q 'suggested command:'; then
    fail_case 'add_tool_update_notice has no suggested-command line'
else
    pass_case 'add_tool_update_notice has no suggested-command line'
fi
if sed -n '/^function tool_status_line()$/,/^}$/p' "$bashrc" | grep -q 'suggested command:'; then
    fail_case 'tool_status_line has no suggested-command line'
else
    pass_case 'tool_status_line has no suggested-command line'
fi

printf '\n=== behavioral: drift detection ===\n'
normalize_version()
{
    local version="$1"
    if [[ "$version" =~ ([0-9]+([.][0-9]+)+) ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
        return
    fi
    printf '%s' "$version"
}
version_lt()
{
    local current_version latest_version
    current_version="$(normalize_version "$1")"
    latest_version="$(normalize_version "$2")"
    [[ -n "$current_version" && -n "$latest_version" && "$current_version" != "$latest_version" ]] || return 1
    [[ "$(printf '%s\n%s\n' "$current_version" "$latest_version" | sort -V | head -n 1)" == "$current_version" ]]
}
versions_equal()
{
    local current_version latest_version
    current_version="$(normalize_version "$1")"
    latest_version="$(normalize_version "$2")"
    [[ -n "$current_version" && -n "$latest_version" && "$current_version" == "$latest_version" ]]
}

# shellcheck disable=SC1090
eval "$(sed -n '/^_tool_version_note_pending()$/,/^}$/p; /^tool_version_pending_drifted()$/,/^}$/p' "$bashrc")"

tool_live_installed_version()
{
    case "$1" in
        git) printf '%s\n' "${TEST_LIVE_GIT-2.54.0}" ;;
        bash)
            if [[ -n "${TEST_LIVE_BASH+x}" ]]; then
                printf '%s\n' "$TEST_LIVE_BASH"
            else
                printf '%s\n' '5.2.0'
            fi
            ;;
        *) return 0 ;;
    esac
}

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
pending="${tmpdir}/pending-updates"
cat >"$pending" <<'EOF'
# tool	installed	path
git	2.54.0	/usr/bin/git
bash	5.2.0	/bin/bash
EOF

unset TEST_LIVE_BASH 2>/dev/null || true
TEST_LIVE_GIT=2.54.0
if tool_version_pending_drifted "$pending"; then
    fail_case 'no drift when live matches recorded'
else
    pass_case 'no drift when live matches recorded'
fi

TEST_LIVE_GIT=2.55.0
if tool_version_pending_drifted "$pending"; then
    pass_case 'drift when git upgraded out-of-band'
else
    fail_case 'drift when git upgraded out-of-band'
fi

TEST_LIVE_GIT=2.54.0
TEST_LIVE_BASH=
if tool_version_pending_drifted "$pending"; then
    pass_case 'drift when binary missing'
else
    fail_case 'drift when binary missing'
fi

if tool_version_pending_drifted "${tmpdir}/missing"; then
    fail_case 'missing pending is not drift'
else
    pass_case 'missing pending is not drift'
fi

printf '\n=== behavioral: note pending dedupe ===\n'
tool_pending_updates_tsv=
_tool_version_note_pending git 2.54.0 2.55.0 /usr/bin/git
_tool_version_note_pending git 2.54.0 2.55.0 /usr/bin/git
_tool_version_note_pending bash 5.2.0 5.2.0 /bin/bash
rows=$(printf '%s' "$tool_pending_updates_tsv" | grep -c . || true)
expected=$'git\t2.54.0\t/usr/bin/git\n'
if [[ "$rows" -eq 1 && "$tool_pending_updates_tsv" == "$expected" ]]; then
    pass_case 'note pending dedupes and skips equal versions'
else
    fail_case "note pending dedupes (rows=$rows got=$(printf '%q' "$tool_pending_updates_tsv"))"
fi

printf '\n=== behavioral: update action classify + footer ===\n'
# shellcheck disable=SC1090
eval "$(sed -n \
    '/^_tool_version_record_update_action()$/,/^}$/p; /^_tool_version_append_update_footer()$/,/^}$/p' \
    "$bashrc")"

tool_update_self_names=
tool_update_admin_hints=
# Read by _tool_version_append_update_footer (color off in tests).
# shellcheck disable=SC2034
tool_status_use_color=
_tool_version_record_update_action pnpm update_pnpm
_tool_version_record_update_action pnpm update_pnpm
_tool_version_record_update_action gh update_gh
_tool_version_record_update_action git 'ask an admin: sudo apt install --only-upgrade git'
_tool_version_record_update_action git 'ask an admin: sudo apt install --only-upgrade git'
if [[ "$tool_update_self_names" == 'pnpm, gh' ]]; then
    pass_case 'self-service names accumulate and dedupe'
else
    fail_case "self-service names accumulate and dedupe (got=$(printf '%q' "$tool_update_self_names"))"
fi
if [[ "$tool_update_admin_hints" == $'  git: ask an admin: sudo apt install --only-upgrade git\n' ]]; then
    pass_case 'admin hints accumulate and dedupe'
else
    fail_case "admin hints accumulate and dedupe (got=$(printf '%q' "$tool_update_admin_hints"))"
fi
footer="$(_tool_version_append_update_footer)"
assert_contains 'footer lists update_tools' "$footer" 'upgrade all (this account): update_tools'
assert_contains 'footer lists self tools' "$footer" 'tools: pnpm, gh'
assert_contains 'footer lists needs admin' "$footer" 'needs admin:'
assert_contains 'footer lists git admin handoff' "$footer" \
    'git: ask an admin: sudo apt install --only-upgrade git'

printf '\n=== behavioral: after-wait report reuse ignores cache mtime ===\n'
# shellcheck disable=SC1090
eval "$(sed -n '/^_tool_version_report_reusable_after_wait()$/,/^}$/p' "$bashrc")"
peer_dir="${tmpdir}/peer-report"
mkdir -p "$peer_dir"
# Minimal colored report with a bash: line (same shape as a real last-report).
printf '\n[tool versions]\n\033[32m  bash: installed 5.2.0, latest 5.2.0\033[0m\n' >"${peer_dir}/last-report"
now=$(date +%s)
printf '%s\n' "$now" >"${peer_dir}/last-check"
if _tool_version_report_reusable_after_wait \
    "${peer_dir}/last-report" "${peer_dir}/last-check" "$now"
then
    pass_case 'after-wait reuses fresh peer report'
else
    fail_case 'after-wait reuses fresh peer report'
fi
printf '%s\n' "$((now - 400))" >"${peer_dir}/last-check"
if _tool_version_report_reusable_after_wait \
    "${peer_dir}/last-report" "${peer_dir}/last-check" "$now"
then
    fail_case 'after-wait rejects stale peer stamp'
else
    pass_case 'after-wait rejects stale peer stamp'
fi

printf '\n=== behavioral: update_tools control flow ===\n'
# Extract update_tools; stub per-tool updaters + invalidate + tool_update_command.
# Log to a file (not a shell var) because update_tools output capture is fine,
# but updater side effects must survive outside any subshell.
# shellcheck disable=SC1090
eval "$(sed -n '/^function update_tools()$/,/^}$/p' "$bashrc")"

update_log="${tmpdir}/updated.log"
out_file="${tmpdir}/update_tools.out"
# update_tools reads this global (same as interactive bashrc).
# shellcheck disable=SC2034
tool_version_state_dir="$tmpdir"
invalidate_tool_version_cache() { :; }
tool_update_command()
{
    case "$1" in
        git) printf 'ask an admin: sudo apt install --only-upgrade git\n' ;;
        bash) printf 'update_bash\n' ;;
        *) return 1 ;;
    esac
}
update_git()
{
    printf 'git\n' >>"$update_log"
    return 1
}
update_bash()
{
    printf 'bash\n' >>"$update_log"
    return 0
}
update_gh() { printf 'gh\n' >>"$update_log"; return 0; }
update_gh_stack() { printf 'gh-stack\n' >>"$update_log"; return 0; }
update_gt() { printf 'gt\n' >>"$update_log"; return 0; }
update_npm() { printf 'npm\n' >>"$update_log"; return 0; }
update_pipx() { printf 'pipx\n' >>"$update_log"; return 0; }
update_pnpm() { printf 'pnpm\n' >>"$update_log"; return 0; }
update_uv() { printf 'uv\n' >>"$update_log"; return 0; }

cat >"$pending" <<'EOF'
# tool	installed	path
git	2.54.0	/usr/bin/git
bash	5.2.0	/bin/bash
EOF

# Live still at recorded versions → both updaters run; git admin hint aggregated.
unset TEST_LIVE_BASH 2>/dev/null || true
TEST_LIVE_GIT=2.54.0
: >"$update_log"
update_tools >"$out_file" 2>&1 || true
out="$(cat "$out_file")"
ran_tools="$(tr '\n' ' ' <"$update_log")"
if [[ "$ran_tools" == *'git '* && "$ran_tools" == *'bash '* ]]; then
    pass_case 'update_tools invokes per-tool helpers'
else
    fail_case "update_tools invokes per-tool helpers (ran: ${ran_tools})"
fi
assert_contains 'update_tools aggregates admin handoff' "$out" 'ask an admin: sudo apt install --only-upgrade git'

# Live git newer than recorded → skip git; still upgrade bash.
TEST_LIVE_GIT=2.55.0
: >"$update_log"
update_tools >"$out_file" 2>&1 || true
out="$(cat "$out_file")"
ran_tools="$(tr '\n' ' ' <"$update_log")"
if [[ "$ran_tools" != *'git '* && "$ran_tools" == *'bash '* && "$out" == *'git already 2.55.0'* ]]; then
    pass_case 'update_tools skips only when live is newer'
else
    fail_case "update_tools skips only when live is newer (ran=${ran_tools} out=$(printf '%q' "$out"))"
fi

# Live git older than recorded (PATH switch / downgrade) → still try update_git.
TEST_LIVE_GIT=2.50.0
: >"$update_log"
update_tools >"$out_file" 2>&1 || true
ran_tools="$(tr '\n' ' ' <"$update_log")"
if [[ "$ran_tools" == *'git '* ]]; then
    pass_case 'update_tools upgrades on downgrade/PATH switch'
else
    fail_case "update_tools upgrades on downgrade/PATH switch (ran=${ran_tools})"
fi

printf '\n=== behavioral: offer self-names + stamp ===\n'
# shellcheck disable=SC1090
eval "$(sed -n \
    '/^_tool_version_self_names_for_offer()$/,/^}$/p; /^_tool_version_can_prompt_yn()$/,/^}$/p; /^_tool_version_maybe_offer_update_tools()$/,/^}$/p' \
    "$bashrc")"

offer_dir="${tmpdir}/offer"
mkdir -p "$offer_dir"
# shellcheck disable=SC2034
tool_version_state_dir="$offer_dir"
printf 'pnpm, uv\n' >"${offer_dir}/pending-self-names"
names="$(_tool_version_self_names_for_offer)"
if [[ "$names" == 'pnpm, uv' ]]; then
    pass_case 'self-names for offer reads sidecar'
else
    fail_case "self-names for offer reads sidecar (got=$(printf '%q' "$names"))"
fi
rm -f "${offer_dir}/pending-self-names"
cat >"${offer_dir}/pending-updates" <<'EOF'
# tool	installed	path
pnpm	11.0.0	/tmp/pnpm
git	2.54.0	/usr/bin/git
uv	0.1.0	/tmp/uv
EOF
# Classify in a subshell so stubs do not shadow earlier update_tools doubles (SC2317).
names="$(
    # Invoked from eval'd _tool_version_self_names_for_offer (SC2317).
    # shellcheck disable=SC2317
    tool_update_command()
    {
        case "$1" in
            git) printf 'ask an admin: sudo apt install --only-upgrade git\n' ;;
            pnpm) printf 'update_pnpm\n' ;;
            uv) printf 'update_uv\n' ;;
            *) return 1 ;;
        esac
    }
    _tool_version_self_names_for_offer
)"
if [[ "$names" == 'pnpm, uv' ]]; then
    pass_case 'self-names for offer classifies pending-updates'
else
    fail_case "self-names for offer classifies pending-updates (got=$(printf '%q' "$names"))"
fi

# Non-promptable environment: must not stamp update-offer-done.
# Stubs are only referenced from the eval'd helper (SC2317).
# shellcheck disable=SC2317
{
    rm -f "${offer_dir}/update-offer-done" "${offer_dir}/offered.log"
    printf '%s\n' '100' >"${offer_dir}/last-check"
    update_tools() { printf 'updated\n' >>"${offer_dir}/offered.log"; }
    _init_prompt_yn() { return 1; }
    _tool_version_can_prompt_yn() { return 1; }
    _tool_version_maybe_offer_update_tools 'pnpm'
    if [[ ! -e "${offer_dir}/update-offer-done" && ! -e "${offer_dir}/offered.log" ]]; then
        pass_case 'maybe-offer skips without stamp when cannot prompt'
    else
        fail_case 'maybe-offer skips without stamp when cannot prompt'
    fi

    # Promptable decline: stamp once; second call no re-prompt.
    _tool_version_can_prompt_yn() { return 0; }
    prompt_count=0
    _init_prompt_yn()
    {
        prompt_count=$((prompt_count + 1))
        return 1
    }
    _tool_version_maybe_offer_update_tools 'pnpm'
    _tool_version_maybe_offer_update_tools 'pnpm'
    if [[ $prompt_count -eq 1 && -r "${offer_dir}/update-offer-done" ]] \
        && [[ "$(tr -d '[:space:]' <"${offer_dir}/update-offer-done")" == '100' ]] \
        && [[ ! -e "${offer_dir}/offered.log" ]]
    then
        pass_case 'maybe-offer stamps decline once per last-check'
    else
        fail_case "maybe-offer stamps decline once per last-check (prompts=${prompt_count})"
    fi

    # Accept path runs update_tools.
    rm -f "${offer_dir}/update-offer-done" "${offer_dir}/offered.log"
    prompt_count=0
    _init_prompt_yn()
    {
        prompt_count=$((prompt_count + 1))
        return 0
    }
    _tool_version_maybe_offer_update_tools 'pnpm'
    if [[ $prompt_count -eq 1 && -r "${offer_dir}/offered.log" ]]; then
        pass_case 'maybe-offer runs update_tools on yes'
    else
        fail_case "maybe-offer runs update_tools on yes (prompts=${prompt_count})"
    fi
}

test_summary
