#!/usr/bin/env bash
# Tests for lib/coderabbit_skills: the preview-only helper for the CodeRabbit CLI agent skills.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

root="$(cd "${script_dir}/.." && pwd)"
readonly root
lib="${root}/lib/coderabbit_skills"
readonly lib

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
home="${work}/home"
readonly home
args_log="${work}/args.log"
readonly args_log

# make_cli <path> <exit-code>: a stub CLI that records its arguments and prints a plan plus the JSON status line.
make_cli() {
  local path="$1" code="$2"
  mkdir -p "$(dirname "$path")"
  {
    printf '#!/bin/sh\n'
    printf 'echo "$*" >> "%s"\n' "$args_log"
    printf 'echo "Install"\n'
    printf 'echo "  Claude Code"\n'
    printf 'echo "    + autofix            %s/.claude/skills/autofix"\n' "$home"
    printf 'echo "{\\"type\\":\\"action_required\\",\\"command\\":\\"coderabbit skills --confirm abc123\\"}"\n'
    printf 'exit %s\n' "$code"
  } >"$path"
  chmod +x "$path"
}

# preview [env...]: run the preview with an isolated HOME and a minimal PATH; prints stdout and stderr, then rc=<n>.
preview() {
  local rc=0 out
  : >"$args_log"
  # shellcheck disable=SC2016  # the bash -c script must expand $1 in the child shell, not here
  # PATH holds only the stubs, so whether a timeout utility exists is decided by the test, not by the host.
  out="$(env -i HOME="$home" PATH="${work}/pathbin" "$@" \
    "$BASH" -c 'source "$1"; init_files_coderabbit_skills_preview ${2:+"$2"}' bash "$lib" "${preview_cli_arg:-}" 2>&1)" || rc=$?
  printf '%s\nrc=%s\n' "$out" "$rc"
}

# A stand-in `timeout` that runs its command (the real one bounds it; this suite only needs it to exist).
add_timeout() {
  printf '#!/bin/sh\nshift\nexec "$@"\n' >"${work}/pathbin/timeout"
  chmod +x "${work}/pathbin/timeout"
}

reset_home() {
  rm -rf "$home" "${work}/pathbin"
  mkdir -p "$home" "${work}/pathbin"
  add_timeout
}

printf '\n=== no CLI: silent and nothing is run ===\n'
reset_home
out="$(preview)"
assert_eq 'no CLI prints only the exit status' "$out" $'\nrc=0'
assert_eq 'no CLI runs nothing' "$(<"$args_log")" ''

printf '\n=== CLI present, no skills: preview the plan, apply nothing ===\n'
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
out="$(preview)"
assert_contains 'says no CodeRabbit skill is installed and this is a preview' "$out" 'Install plan (preview only, nothing is changed)'
assert_contains "prints the CLI's own plan" "$out" '+ autofix'
assert_contains "prints the CLI's confirm command line" "$out" 'coderabbit skills --confirm abc123'
assert_contains 'says nothing was installed' "$out" 'nothing was installed'
assert_contains 'succeeds' "$out" 'rc=0'
assert_eq 'the CLI is run with exactly: skills --agent' "$(<"$args_log")" 'skills --agent'
assert_not_contains 'the helper never passes --confirm itself' "$(<"$args_log")" '--confirm'

printf '\n=== the path provision recorded wins, and a stale recorded path falls back ===\n'
reset_home
make_cli "${work}/elsewhere/bin/coderabbit" 0
out="$(preview init_tool_coderabbit="${work}/elsewhere/bin/coderabbit")"
assert_contains 'a recorded CLI that is not on PATH still gets previewed' "$out" '+ autofix'
assert_eq 'the recorded CLI is the one run' "$(<"$args_log")" 'skills --agent'
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
out="$(preview init_tool_coderabbit="${work}/gone/coderabbit")"
assert_contains 'a recorded path that no longer exists falls back to ~/.local/bin' "$out" '+ autofix'
assert_eq 'and runs the fallback CLI' "$(<"$args_log")" 'skills --agent'
reset_home
out="$(preview init_tool_coderabbit="${work}/gone/coderabbit")"
assert_eq 'a stale recorded path and no other CLI stays silent' "$out" $'\nrc=0'

printf '\n=== an explicit CLI argument wins over a stale recorded path (update_coderabbit passes what it just installed) ===\n'
reset_home
make_cli "${work}/old/coderabbit" 3
make_cli "${home}/.local/bin/coderabbit" 0
preview_cli_arg="${home}/.local/bin/coderabbit"
out="$(preview init_tool_coderabbit="${work}/old/coderabbit")"
preview_cli_arg=''
assert_contains 'the freshly installed CLI is previewed, not the stale recorded one' "$out" '+ autofix'
assert_not_contains 'and nothing warns about a failed preview' "$out" 'WARNING'
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
preview_cli_arg="${work}/missing/coderabbit"
out="$(preview)"
preview_cli_arg=''
assert_contains 'a non-executable explicit path falls back to discovery' "$out" '+ autofix'

printf '\n=== the cr alias on PATH alone also previews ===\n'
reset_home
make_cli "${work}/pathbin/cr" 0
out="$(preview)"
assert_contains 'cr alone prints the plan' "$out" '+ autofix'
assert_eq 'cr is run with: skills --agent' "$(<"$args_log")" 'skills --agent'

printf '\n=== no timeout utility: skip the network preview and say how to run it ===\n'
reset_home
rm -f "${work}/pathbin/timeout"
make_cli "${home}/.local/bin/coderabbit" 0
out="$(preview)"
assert_contains 'without timeout or gtimeout the preview is skipped with the manual command' "$out" \
  'No timeout utility (timeout or gtimeout) is available to bound the network preview, so it was skipped; run: coderabbit skills --agent'
assert_contains 'and never fails the caller' "$out" 'rc=0'
assert_eq 'and the CLI is not run' "$(<"$args_log")" ''
assert_not_contains 'and does not claim a plan was shown' "$out" 'nothing was installed'
reset_home
rm -f "${work}/pathbin/timeout"
printf '#!/bin/sh\nshift\nexec "$@"\n' >"${work}/pathbin/gtimeout"
chmod +x "${work}/pathbin/gtimeout"
make_cli "${home}/.local/bin/coderabbit" 0
out="$(preview)"
assert_contains 'gtimeout alone is enough to run the preview' "$out" '+ autofix'

printf '\n=== skills already installed: silent and nothing is run ===\n'
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
mkdir -p "${home}/.claude/skills/code-review"
printf '%s\n' '---' 'name: code-review' 'description: Run CodeRabbit CLI reviews' '---' >"${home}/.claude/skills/code-review/SKILL.md"
out="$(preview)"
assert_eq 'a CodeRabbit code-review skill silences the preview' "$out" $'\nrc=0'
assert_eq 'and nothing is run' "$(<"$args_log")" ''

reset_home
make_cli "${home}/.local/bin/coderabbit" 0
mkdir -p "${home}/.gemini/skills/coderabbit-config"
out="$(preview)"
assert_eq 'a coderabbit-config directory counts by name' "$out" $'\nrc=0'

printf '\n=== a user-owned generic skill does not hide the preview ===\n'
for generic in code-review autofix; do
  reset_home
  make_cli "${home}/.local/bin/coderabbit" 0
  mkdir -p "${home}/.claude/skills/${generic}"
  printf '%s\n' '---' "name: ${generic}" 'description: my own skill' '---' >"${home}/.claude/skills/${generic}/SKILL.md"
  out="$(preview)"
  assert_contains "a non-CodeRabbit ${generic} skill still previews" "$out" 'Install plan (preview only'
done
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
mkdir -p "${home}/.claude/skills/code-review"
out="$(preview)"
assert_contains 'a generic-name directory with no SKILL.md still previews' "$out" 'Install plan (preview only'

printf '\n=== plugin installs count; marketplace listings and stray files do not ===\n'
for plugin_dir in .claude/plugins/coderabbit .claude/plugins/cache/some-market/coderabbit .codex/plugins/cache/m/coderabbit-plugin/1.0; do
  reset_home
  make_cli "${home}/.local/bin/coderabbit" 0
  mkdir -p "${home}/${plugin_dir}"
  out="$(preview)"
  assert_eq "a plugin at ~/${plugin_dir} silences the preview" "$out" $'\nrc=0'
done
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
mkdir -p "${home}/.claude/plugins/marketplaces/coderabbit-marketplace"
out="$(preview)"
assert_contains 'a marketplace listing that was added but not installed still previews' "$out" 'Install plan (preview only'
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
mkdir -p "${home}/.claude/plugins"
: >"${home}/.claude/plugins/coderabbit.log"
out="$(preview)"
assert_contains 'a stray file named after CodeRabbit still previews' "$out" 'Install plan (preview only'

printf '\n=== switches and failures ===\n'
reset_home
make_cli "${home}/.local/bin/coderabbit" 0
out="$(preview INIT_FILES_CODERABBIT_SKILLS_PREVIEW=0)"
assert_eq 'INIT_FILES_CODERABBIT_SKILLS_PREVIEW=0 silences the preview' "$out" $'\nrc=0'
assert_eq 'and nothing is run' "$(<"$args_log")" ''

reset_home
make_cli "${home}/.local/bin/coderabbit" 3
out="$(preview)"
assert_contains 'a failing CLI warns with the manual command' "$out" 'WARNING: could not preview the CodeRabbit skills plan (exit 3); run: coderabbit skills --agent'
assert_contains 'and never fails the caller' "$out" 'rc=0'
assert_not_contains 'and does not claim the plan was shown' "$out" 'nothing was installed'

printf '\n=== static: the helper is wired in and never applies ===\n'
lib_text="$(<"$lib")"
bashrc_text="$(<"${root}/bashrc")"
provision_text="$(<"${root}/provision_init_files")"
assert_not_contains 'the lib never runs the CLI with --confirm' "$lib_text" 'skills --confirm'
# shellcheck disable=SC2016  # literal source text to match, not an expansion
assert_contains 'bashrc sources the lib' "$bashrc_text" '"${_init_files_clone_dir}/lib/coderabbit_skills"'
# shellcheck disable=SC2016  # literal source text to match, not an expansion
assert_contains 'update_coderabbit previews with the CLI it just installed' "$bashrc_text" 'init_files_coderabbit_skills_preview "$HOME/.local/bin/coderabbit"'
# shellcheck disable=SC2016  # literal source text to match, not an expansion
assert_contains 'provision sources the lib' "$provision_text" '. "${repo_dir}/lib/coderabbit_skills"'
# shellcheck disable=SC2016  # literal source text to match, not an expansion
assert_contains 'provision previews only on interactive runs' "$provision_text" \
  '[[ $quiet -eq 0 && $force -eq 0 && -t 0 && -t 2 ]]'

test_summary
