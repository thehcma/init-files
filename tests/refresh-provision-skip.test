#!/usr/bin/env bash
# Tests for refresh_init_files last-provisioned SHA skip helpers.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

root="$(cd "${script_dir}/.." && pwd)"
readonly root
bashrc="${root}/bashrc"

printf '\n=== static: helpers + skip call sites ===\n'
text="$(<"$bashrc")"
assert_contains 'defines last-provisioned path' "$text" '_init_files_last_provisioned_path()'
assert_contains 'defines read last-provisioned' "$text" '_init_files_read_last_provisioned()'
assert_contains 'defines write last-provisioned' "$text" '_init_files_write_last_provisioned()'
assert_contains 'defines already-current check' "$text" '_init_files_provision_already_current()'
assert_contains 'default force is off' "$text" 'local force=0'
assert_contains 'skip message mentions -f' "$text" 'use -f to force'
# Needle is a literal bashrc snippet (includes "$new_head").
# shellcheck disable=SC2016
assert_contains 'writes stamp after provision' "$text" '_init_files_write_last_provisioned "$new_head"'
assert_contains 'defines daily-check-due helper' "$text" '_init_files_daily_check_due()'
assert_contains 'defines daily-check stamp writer' "$text" '_init_files_write_daily_check_stamp()'
# Needle is a literal bashrc snippet (includes "$init_files_check_stamp").
# shellcheck disable=SC2016
assert_contains 'quiet gate calls daily-check-due' "$text" '_init_files_daily_check_due "$init_files_check_stamp"'

printf '\n=== behavioral: stamp read/write + already-current ===\n'
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

# shellcheck disable=SC1090
eval "$(sed -n \
    '/^_init_files_last_provisioned_path()$/,/^}$/p; /^_init_files_read_last_provisioned()$/,/^}$/p; /^_init_files_write_last_provisioned()$/,/^}$/p; /^_init_files_provision_already_current()$/,/^}$/p; /^_init_files_daily_check_due()$/,/^}$/p; /^_init_files_write_daily_check_stamp()$/,/^}$/p' \
    "$bashrc")"

# shellcheck disable=SC2034
init_files_state_dir="$tmpdir/state"
# shellcheck disable=SC2034
init_files_host="testhost"
mkdir -p "$init_files_state_dir"

path="$(_init_files_last_provisioned_path)"
assert_contains 'stamp path is per-host' "$path" 'last-provisioned.testhost'

if _init_files_read_last_provisioned; then
    fail_case 'missing stamp is not readable'
else
    pass_case 'missing stamp is not readable'
fi

sha='abcdef0123456789abcdef0123456789abcdef01'
_init_files_write_last_provisioned "$sha"
got="$(_init_files_read_last_provisioned)"
if [[ "$got" == "$sha" ]]; then
    pass_case 'round-trip last-provisioned sha'
else
    fail_case "round-trip last-provisioned sha (got=$got)"
fi

# Invoked indirectly by _init_files_provision_already_current.
# shellcheck disable=SC2317
_init_files_deploy_drift_reasons() { :; }
if _init_files_provision_already_current "$sha"; then
    pass_case 'already-current when stamp matches and no drift'
else
    fail_case 'already-current when stamp matches and no drift'
fi
if _init_files_provision_already_current 'deadbeefdeadbeefdeadbeefdeadbeefdeadbeef'; then
    fail_case 'not current when stamp differs'
else
    pass_case 'not current when stamp differs'
fi

# shellcheck disable=SC2317
_init_files_deploy_drift_reasons() { printf 'bashrc symlink is wrong\n'; }
if _init_files_provision_already_current "$sha"; then
    fail_case 'not current when deploy drifted'
else
    pass_case 'not current when deploy drifted'
fi

printf '\n=== behavioral: daily-check-due bypasses throttle on local HEAD move ===\n'
stamp="$tmpdir/last-check"
now=1000000
max_age=86400
head_a='1111111111111111111111111111111111111111'
head_b='2222222222222222222222222222222222222222'

if _init_files_daily_check_due "$stamp" "$now" "$max_age" "$head_a"; then
    pass_case 'due when stamp file missing'
else
    fail_case 'due when stamp file missing'
fi

_init_files_write_daily_check_stamp "$stamp" "$now" "$head_a"
if [[ "$(cat "$stamp")" == "$now" && "$(cat "${stamp}.head")" == "$head_a" ]]; then
    pass_case 'stamp writer records time + head'
else
    fail_case 'stamp writer records time + head'
fi

if _init_files_daily_check_due "$stamp" "$((now + 60))" "$max_age" "$head_a"; then
    fail_case 'not due: same head, within max age'
else
    pass_case 'not due: same head, within max age'
fi

if _init_files_daily_check_due "$stamp" "$((now + 60))" "$max_age" "$head_b"; then
    pass_case 'due: HEAD moved since last check, even within max age'
else
    fail_case 'due: HEAD moved since last check, even within max age'
fi

if _init_files_daily_check_due "$stamp" "$((now + max_age + 1))" "$max_age" "$head_a"; then
    pass_case 'due: stamp expired, same head'
else
    fail_case 'due: stamp expired, same head'
fi

test_summary
