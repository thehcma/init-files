#!/usr/bin/env bash
# encrypt() copies an existing <name>.crypt into ~/backup-crypt first, and that
# directory must only ever hold gpg-encrypted data. Uses a throwaway HOME.
set -euo pipefail

script_dir="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
readonly script_dir

# shellcheck disable=SC1091
source "${script_dir}/lib/test-assert"
test_init

root="$(cd "${script_dir}/.." && pwd)"
readonly root

if ! command -v gpg > /dev/null 2>&1; then
    echo "SKIP: gpg not installed"
    exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

eval "$(sed -n '/^function _init_crypt_backup()/,/^}/p' "${root}/bashrc")"
eval "$(sed -n '/^function encrypt()/,/^}/p' "${root}/bashrc")"

init_tool_gpg="$(command -v gpg)"
export GNUPGHOME="$tmp/gnupg"
mkdir -m 700 "$GNUPGHOME"
export HOME="$tmp/home"
export TMPDIR="$tmp/tmpdir"
mkdir -p "$HOME" "$tmp/work" "$TMPDIR"

# Batch passphrase instead of the interactive pinentry used by the real wrapper.
gpg_symmetric()
{
    "$init_tool_gpg" --batch --yes --pinentry-mode loopback --passphrase test "$@"
}

count_in() { find "$1" -mindepth 1 -maxdepth 1 -name "${2:-*}" 2> /dev/null | wc -l | tr -d ' '; }

printf 'one\n' > "$tmp/work/foo"
encrypt "$tmp/work/foo" 2> /dev/null
assert_eq "first encrypt creates no backup" "0" "$(count_in "$HOME/backup-crypt")"

cp -p "$tmp/work/foo.crypt" "$tmp/first.crypt"
printf 'two\n' > "$tmp/work/foo"
encrypt "$tmp/work/foo" 2> /dev/null
assert_eq "second encrypt backs up old .crypt" "1" "$(count_in "$HOME/backup-crypt")"
backup="$(find "$HOME/backup-crypt" -name 'foo.*' | head -n 1)"
assert_files_equal "backup matches previous .crypt" "$tmp/first.crypt" "$backup"

printf 'three\n' > "$tmp/work/foo"
encrypt "$tmp/work/foo" 2> /dev/null
assert_eq "backups accumulate" "2" "$(count_in "$HOME/backup-crypt")"

# Invariant: never put plaintext in the backup directory; refuse and leave
# the destination untouched.
printf 'plain secret\n' > "$tmp/work/bar.crypt"
printf 'bar\n' > "$tmp/work/bar"
rc=0
encrypt "$tmp/work/bar" 2> /dev/null || rc=$?
assert_exit_nonzero "encrypt refuses when existing .crypt is not encrypted" "$rc"
assert_eq "plaintext .crypt untouched" "plain secret" "$(cat "$tmp/work/bar.crypt")"
assert_eq "original kept on refusal" "bar" "$(cat "$tmp/work/bar")"
assert_eq "no plaintext leaked into backups" "0" "$(grep -rl 'plain secret' "$HOME/backup-crypt" | wc -l | tr -d ' ')"

# A plaintext OpenPGP literal packet named "encrypted data" must not pass.
printf 'spoof secret\n' > "$tmp/spoof.in"
gpg --batch --store --set-filename 'encrypted data' -o "$tmp/work/baz.crypt" "$tmp/spoof.in" 2> /dev/null
printf 'baz\n' > "$tmp/work/baz"
rc=0
encrypt "$tmp/work/baz" 2> /dev/null || rc=$?
assert_exit_nonzero "encrypt refuses spoofed literal packet" "$rc"
assert_eq "no spoofed plaintext in backups" "0" "$(grep -rl 'spoof secret' "$HOME/backup-crypt" | wc -l | tr -d ' ')"
assert_eq "no temp snapshots left behind" "0" "$(count_in "$TMPDIR" 'crypt-backup*')"

# A valid session-key packet followed by raw plaintext must be refused.
head -c 15 "$tmp/first.crypt" > "$tmp/work/qux.crypt"
printf 'trailing secret\n' >> "$tmp/work/qux.crypt"
printf 'qux\n' > "$tmp/work/qux"
rc=0
encrypt "$tmp/work/qux" 2> /dev/null || rc=$?
assert_exit_nonzero "encrypt refuses session key + raw plaintext" "$rc"
assert_eq "no trailing plaintext in backups" "0" "$(grep -rl 'trailing secret' "$HOME/backup-crypt" | wc -l | tr -d ' ')"

# Long basenames still back up (backup name stays under NAME_MAX).
long="$(printf 'a%.0s' $(seq 1 240))"
printf 'l1\n' > "$tmp/work/$long"
encrypt "$tmp/work/$long" 2> /dev/null
printf 'l2\n' > "$tmp/work/$long"
rc=0
encrypt "$tmp/work/$long" 2> /dev/null || rc=$?
assert_eq "long basename backs up" "0" "$rc"
assert_eq "long basename backup exists" "1" "$(count_in "$HOME/backup-crypt" 'aaaa*')"

test_summary
