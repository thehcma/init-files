#!/usr/bin/env bash
# Shared assertion helpers for tests/*. (pattern from the-hcma/repository-helpers)
set -euo pipefail

test_init() {
  pass=0
  fail=0
}

pass_case() {
  printf '[PASS] %s\n' "$1"
  pass=$((pass + 1))
}

fail_case() {
  printf '[FAIL] %s\n' "$1"
  fail=$((fail + 1))
}

assert_eq() {
  local label="$1"
  local got="$2"
  local want="$3"
  if [[ "$got" == "$want" ]]; then
    pass_case "$label"
  else
    printf '%s\n' "---- got ----" >&2
    printf '%s\n' "$got" >&2
    printf '%s\n' "---- want ----" >&2
    printf '%s\n' "$want" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  fi
}

assert_contains() {
  local label="$1"
  local haystack="$2"
  local needle="$3"
  if grep -qF -- "$needle" <<<"$haystack"; then
    pass_case "$label"
  else
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  fi
}

assert_not_contains() {
  local label="$1"
  local haystack="$2"
  local needle="$3"
  if grep -qF -- "$needle" <<<"$haystack"; then
    printf '%s\n' '---- output ----' >&2
    printf '%s\n' "$haystack" >&2
    printf '%s\n' '--------------' >&2
    fail_case "$label"
  else
    pass_case "$label"
  fi
}

assert_exit_0() {
  local label="$1"
  local exit_code="$2"
  if [[ "$exit_code" -eq 0 ]]; then
    pass_case "$label"
  else
    fail_case "$label (exit $exit_code)"
  fi
}

assert_exit_nonzero() {
  local label="$1"
  local exit_code="$2"
  if [[ "$exit_code" -ne 0 ]]; then
    pass_case "$label"
  else
    fail_case "$label (expected non-zero)"
  fi
}

assert_files_equal() {
  local label="$1"
  local left="$2"
  local right="$3"
  if cmp -s "$left" "$right"; then
    pass_case "$label"
  else
    fail_case "$label"
  fi
}

test_summary() {
  printf '\n%d passed, %d failed\n' "$pass" "$fail"
  if ((fail > 0)); then
    return 1
  fi
  return 0
}
