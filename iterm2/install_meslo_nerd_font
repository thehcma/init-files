#!/usr/bin/env bash
# Install Meslo LGS Nerd Font into the current user's font directory (no sudo).
# Prefer this over `brew install --cask font-meslo-lg-nerd-font` when Homebrew
# is owned by another account — brew puts fonts in that owner's ~/Library/Fonts.
set -euo pipefail

fonts_dir="${HOME}/Library/Fonts"
# Upstream release asset (same URL as docs/shell-ux.md for Linux).
meslo_zip_url="${INIT_FILES_MESLO_ZIP_URL:-https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Meslo.zip}"

usage()
{
    cat <<'EOF'
Usage: iterm2/install_meslo_nerd_font [-y|--yes] [-h|--help]

Download Meslo.zip from nerd-fonts and install Meslo LGS Nerd Font faces into
~/Library/Fonts (macOS) or ~/.local/share/fonts/MesloLGS (Linux). No sudo.

  -y, --yes   do not prompt
EOF
}

assume_yes=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes) assume_yes=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *)
            printf 'install_meslo_nerd_font: unknown option: %s\n' "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

prompt_yn()
{
    local prompt="$1" reply
    [[ $assume_yes -eq 1 ]] && return 0
    if [[ ! -t 0 || ! -t 2 ]]; then
        return 1
    fi
    printf '%s ' "$prompt" >&2
    read -r reply || reply=n
    case "$reply" in
        ''|y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

curl_bin="$(command -v curl 2>/dev/null || true)"
[[ -n "$curl_bin" && -x "$curl_bin" ]] || {
    printf 'install_meslo_nerd_font: curl required\n' >&2
    exit 1
}

unzip_bin="$(command -v unzip 2>/dev/null || true)"
[[ -n "$unzip_bin" && -x "$unzip_bin" ]] || {
    printf 'install_meslo_nerd_font: unzip required\n' >&2
    exit 1
}

if [[ "${OSTYPE:-}" == darwin* ]]; then
    dest_dir="$fonts_dir"
elif [[ "${OSTYPE:-}" == linux* ]]; then
    dest_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/MesloLGS"
else
    printf 'install_meslo_nerd_font: unsupported OS (%s)\n' "${OSTYPE:-unknown}" >&2
    exit 1
fi

if [[ $assume_yes -eq 0 ]]; then
    if ! prompt_yn "Download Meslo Nerd Font into ${dest_dir/#$HOME/~}? [Y/n]"; then
        printf 'install_meslo_nerd_font: skipped\n' >&2
        exit 0
    fi
fi

mkdir -p "$dest_dir" || {
    printf 'install_meslo_nerd_font: cannot create %s\n' "$dest_dir" >&2
    exit 1
}

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/meslo-nerd.XXXXXX")" || exit 1
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT

zip_path="$tmp_dir/Meslo.zip"
extract_dir="$tmp_dir/extract"
mkdir -p "$extract_dir"

printf 'install_meslo_nerd_font: downloading Meslo.zip…\n' >&2
if ! "$curl_bin" --fail --location --silent --show-error \
    --connect-timeout 15 --max-time 180 \
    -o "$zip_path" "$meslo_zip_url"
then
    printf 'install_meslo_nerd_font: download failed (%s)\n' "$meslo_zip_url" >&2
    exit 1
fi

printf 'install_meslo_nerd_font: extracting…\n' >&2
"$unzip_bin" -qo "$zip_path" -d "$extract_dir"

# Prefer the Mono / regular faces the curated iTerm profile needs; copy all
# Meslo LGS Nerd Font ttf/otf so Bold/Italic work too.
copied=0
while IFS= read -r -d '' font_file; do
    base="$(basename "$font_file")"
    case "$base" in
        MesloLGS*NerdFont*.ttf|MesloLGS*NerdFont*.otf|MesloLGS*NFM*.ttf|MesloLGS*NFM*.otf)
            cp -f "$font_file" "$dest_dir/" || continue
            copied=$((copied + 1))
            ;;
    esac
done < <(find "$extract_dir" \( -name '*.ttf' -o -name '*.otf' \) -print0 2>/dev/null)

if [[ $copied -eq 0 ]]; then
    printf 'install_meslo_nerd_font: no Meslo LGS Nerd Font files found in zip\n' >&2
    exit 1
fi

if [[ "${OSTYPE:-}" == linux* ]] && command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "$dest_dir" >/dev/null 2>&1 || true
fi

printf 'install_meslo_nerd_font: installed %d font file(s) → %s\n' \
    "$copied" "${dest_dir/#$HOME/~}" >&2
if [[ "${OSTYPE:-}" == darwin* ]]; then
    printf 'install_meslo_nerd_font: quit and reopen iTerm (Cmd-Q) if glyphs still missing\n' >&2
fi
